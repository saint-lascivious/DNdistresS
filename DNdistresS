apply_concurrency_safety_clamps() {

    if [ "$_MAXIMUM" -gt 128 ] && [ "${_FORCE_MAXIMUM:-0}" -ne 1 ]; then

        log 2 "${LIGHT_GREY}_MAXIMUM${YELLOW} too high (${LIGHT_GREY}$_MAXIMUM${YELLOW}), clamping to ${LIGHT_GREY}128"

        log 3 "to override, use ${LIGHT_GREY}--maximum <value>!${BLUE} (e.g. ${LIGHT_GREY}--maximum 256!${BLUE})"

        _MAXIMUM=128
    fi

    max_burst=$((_QPS * 2))

    if [ "$_FORCE_BURST" -eq 0 ]; then
        _BURST_EFFECTIVE="$max_burst"

        if [ "$_BURST" -gt "$_BURST_EFFECTIVE" ]; then

            log 2 "${LIGHT_GREY}_BURST${YELLOW} too high for _QPS (${LIGHT_GREY}$_BURST ${YELLOW}> ${LIGHT_GREY}$_BURST_EFFECTIVE${YELLOW}), clamping to ${LIGHT_GREY}$_BURST_EFFECTIVE"

            log 3 "to override, use ${LIGHT_GREY}--burst <value>!${BLUE} (e.g. ${LIGHT_GREY}--burst 256!${BLUE})"

            _BURST="$_BURST_EFFECTIVE"
        fi

    else
        _BURST_EFFECTIVE="$_BURST"

        log 3 "burst force override enabled: ${LIGHT_GREY}$_BURST ${BLUE}(unclamped)"

    fi

    is_posint "$_DIG_BATCH_SIZE" || _DIG_BATCH_SIZE=16

    if [ "$_DIG_BATCH_SIZE" -lt 1 ]; then
        _DIG_BATCH_SIZE=1
    fi

    _DIG_BATCH_SIZE_EFFECTIVE="$_DIG_BATCH_SIZE"

    if [ "$_DIG_BATCH_SIZE_EFFECTIVE" -gt "$_BURST" ]; then
        _DIG_BATCH_SIZE_EFFECTIVE="$_BURST"
    fi

    [ "$_DIG_BATCH_SIZE_EFFECTIVE" -ge 1 ] || _DIG_BATCH_SIZE_EFFECTIVE=1

}

rand_u32() {

    if [ -r /dev/urandom ] && need_cmd od; then

        od -An -N4 -tu4 /dev/urandom 2>/dev/null | awk '{ print $1; exit }'

        log 4 "using ${LIGHT_GREY}/dev/urandom${GREY} for random number generation"

        return 0
    fi

    awk -v s="$(now_ms)" -v p="$$" 'BEGIN {
        srand((s + p) % 2147483647)
        printf "%.0f\n", rand() * 4294967295
    }'

    log 2 "${GREY}using weak random number generator (no ${LIGHT_GREY}/dev/urandom${GREY} or ${LIGHT_GREY}od${GREY} available)"

}

rand_int_range() {
    min="$1"
    max="$2"

    is_posint "$min" || return 1

    is_posint "$max" || return 1

    [ "$max" -ge "$min" ] || return 1

    span=$((max - min + 1))
    r="$(rand_u32 2>/dev/null || true)"

    case "$r" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    printf '%s\n' $((min + (r % span)))
}

auto_tune_worker_and_burst() {

    if [ "${_AUTO_TUNE:-0}" -ne 1 ]; then

        log 3 "skipping auto-tune"

        log 3 "use ${LIGHT_GREY}--auto-tune${BLUE} to enable auto-tuning of worker and burst"

        return 0
    fi

    if [ ! -s "$DOMAINS" ]; then

        log 3 "skipping auto-tune"

        log 3 "domain list empty/unreadable (${LIGHT_GREY}$DOMAINS${BLUE})"

        return 0
    fi

    total_domains="$(wc -l < "$DOMAINS" | tr -d ' ')"

    is_posint "$total_domains" || {

        log 3 "skipping auto-tune"

        log 3 "invalid domain count (${LIGHT_GREY}$total_domains${BLUE})"

        return 0
    }

    samples="${_AUTO_TUNE_SAMPLES:-10}"

    if ! is_posint "$samples"; then

        log 2 "invalid ${LIGHT_GREY}_AUTO_TUNE_SAMPLES${YELLOW} (${LIGHT_GREY}$samples${YELLOW}); using ${LIGHT_GREY}10"

        samples=10
    fi

    min_samples=""
    max_samples=""
    have_min=0
    have_max=0

    if [ -n "${_AUTO_TUNE_SAMPLES_MIN:-}" ]; then

        if is_posint "$_AUTO_TUNE_SAMPLES_MIN"; then
            min_samples="$_AUTO_TUNE_SAMPLES_MIN"
            have_min=1
        else
            log 2 "invalid ${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MIN${YELLOW} (${LIGHT_GREY}$_AUTO_TUNE_SAMPLES_MIN${YELLOW}); ignoring range mode"
        fi

    fi

    if [ -n "${_AUTO_TUNE_SAMPLES_MAX:-}" ]; then

        if is_posint "$_AUTO_TUNE_SAMPLES_MAX"; then
            max_samples="$_AUTO_TUNE_SAMPLES_MAX"
            have_max=1
        else

            log 2 "invalid ${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MAX${YELLOW} (${LIGHT_GREY}$_AUTO_TUNE_SAMPLES_MAX${YELLOW}); ignoring range mode"

        fi

    fi

    if [ "$have_min" -eq 1 ] && [ "$have_max" -eq 1 ]; then

        if [ "$min_samples" -gt "$total_domains" ]; then

            log 2 "${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MIN${YELLOW} (${LIGHT_GREY}$min_samples${YELLOW}) exceeds total domains (${LIGHT_GREY}$total_domains${YELLOW}), clamping"

            min_samples="$total_domains"
            _AUTO_TUNE_SAMPLES_MIN="$min_samples"
        fi

        if [ "$max_samples" -gt "$total_domains" ]; then

            log 2 "${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MAX${YELLOW} (${LIGHT_GREY}$max_samples${YELLOW}) exceeds total domains (${LIGHT_GREY}$total_domains${YELLOW}), clamping"

            max_samples="$total_domains"
            _AUTO_TUNE_SAMPLES_MAX="$max_samples"
        fi

        if [ "$max_samples" -ge "$min_samples" ]; then
            samples="$(rand_int_range "$min_samples" "$max_samples" 2>/dev/null || printf '%s\n' "$samples")"
        else

            log 2 "${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MAX${YELLOW} (${LIGHT_GREY}$max_samples${YELLOW}) is lower than ${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MIN${YELLOW} (${LIGHT_GREY}$min_samples${YELLOW}); using ${LIGHT_GREY}_AUTO_TUNE_SAMPLES${YELLOW} (${LIGHT_GREY}$samples${YELLOW})"

        fi

    elif [ "$have_min" -eq 1 ] || [ "$have_max" -eq 1 ]; then

        log 2 "auto-tune range requires ${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MIN${YELLOW} and ${LIGHT_GREY}_AUTO_TUNE_SAMPLES_MAX"

        log 3 "using ${LIGHT_GREY}_AUTO_TUNE_SAMPLES${BLUE} (${LIGHT_GREY}$samples${BLUE})"

    fi

    is_posint "$samples" || samples=10

    if [ "$samples" -gt "$total_domains" ]; then

        log 2 "auto-tune sample count (${LIGHT_GREY}$samples${YELLOW}) exceeds total domains (${LIGHT_GREY}$total_domains${YELLOW}), clamping"

        samples="$total_domains"
    fi

    probe_file="$TMPDIR/auto_tune_probe.txt"

    sample_domains_from_file "$DOMAINS" "$samples" random > "$probe_file"

    probe_n="$(wc -l < "$probe_file" | tr -d ' ')"

    if [ "$probe_n" -le 0 ]; then

        log 3 "skipping auto-tune"

        log 3 "no domains available for warmup"

        return 0
    fi

    log 3 "probing ${LIGHT_GREY}$probe_n${BLUE} sample domains"

    if [ "${_RANDOM:-0}" -eq 1 ]; then
        probe_type_mode="random"
    else
        probe_type_mode="fixed($_TYPE)"
    fi

    auto_batch_effective=1

    if [ "$_BINARY" = "dig" ] && [ "${_DIG_BATCH:-0}" -eq 1 ]; then
        auto_batch_effective="${_DIG_BATCH_SIZE_EFFECTIVE:-$_DIG_BATCH_SIZE}"

        is_posint "$auto_batch_effective" || auto_batch_effective=1

        [ "$auto_batch_effective" -ge 1 ] || auto_batch_effective=1

    fi

    log 4 "samples=${LIGHT_GREY}$probe_n${GREY} type_mode=${LIGHT_GREY}$probe_type_mode${GREY} batch_effective=${LIGHT_GREY}$auto_batch_effective"

    old_output="$_OUTPUT"
    old_answers_file="$ANSWERS_FILE"
    _OUTPUT="quiet"
    ANSWERS_FILE="$TMPDIR/auto_tune_answers.txt"

    started_ms="$(now_ms)"
    done_n=0

    lat_file="$TMPDIR/auto_tune_lat_ms.txt"
    : > "$lat_file"

    if [ "$_BINARY" = "dig" ] && [ "${_DIG_BATCH:-0}" -eq 1 ] && [ "$auto_batch_effective" -gt 1 ]; then

        log 4 "auto-tune warmup using batched dig probes (size=${LIGHT_GREY}$auto_batch_effective${GREY})"

        batch_seq=0
        batch_file=""
        batch_count=0

        while IFS= read -r d || [ -n "$d" ]; do

            [ -n "$d" ] || continue

            if [ "$batch_count" -eq 0 ]; then
                batch_seq=$((batch_seq + 1))
                batch_file="$TMPDIR/auto_tune_probe_batch.$batch_seq.txt"
                : > "$batch_file"
            fi

            probe_qtype="$(resolve_probe_qtype)"
            printf '%s %s\n' "$d" "$probe_qtype" >> "$batch_file" || continue
            batch_count=$((batch_count + 1))

            if [ "$batch_count" -ge "$auto_batch_effective" ]; then
                q_ms="$(probe_dig_batch_latency_ms "$batch_file" "$ANSWERS_FILE" "$RESOLVER" "$_PORT" 2>/dev/null || printf '1\n')"
                printf '%s\n' "$q_ms" >> "$lat_file"
                done_n=$((done_n + 1))

                rm -f "$batch_file" 2>/dev/null || true

                batch_file=""
                batch_count=0
            fi

        done < "$probe_file"

        if [ "$batch_count" -gt 0 ] && [ -n "$batch_file" ] && [ -s "$batch_file" ]; then
            q_ms="$(probe_dig_batch_latency_ms "$batch_file" "$ANSWERS_FILE" "$RESOLVER" "$_PORT" 2>/dev/null || printf '1\n')"
            printf '%s\n' "$q_ms" >> "$lat_file"
            done_n=$((done_n + 1))

            rm -f "$batch_file" 2>/dev/null || true

        fi

    else

        while IFS= read -r d || [ -n "$d" ]; do

            [ -n "$d" ] || continue

            probe_qtype="$(resolve_probe_qtype)"
            q_ms="$(probe_query_latency_ms "$d" "$probe_qtype" "$ANSWERS_FILE" "$RESOLVER" "$_PORT" 2>/dev/null || printf '1\n')"

            printf '%s\n' "$q_ms" >> "$lat_file"
            done_n=$((done_n + 1))
        done < "$probe_file"

    fi

    ended_ms="$(now_ms)"

    _OUTPUT="$old_output"
    ANSWERS_FILE="$old_answers_file"

    rm -f "$probe_file" "$TMPDIR/auto_tune_answers.txt" 2>/dev/null || true

    if [ "$done_n" -le 0 ]; then

        log 3 "skipping auto-tune"

        log 3 "warmup produced no samples"

        rm -f "$lat_file" 2>/dev/null || true

        return 0
    fi

    elapsed_ms=$((ended_ms - started_ms))

    [ "$elapsed_ms" -lt 1 ] && elapsed_ms=1

    trim_pct="${_AUTO_TUNE_TRIM_PCT:-10}"
    pctl="${_AUTO_TUNE_PERCENTILE:-95}"
    pctl_ratio="${_AUTO_TUNE_PCTL_MAX_RATIO:-4}"
    max_growth_factor="${_AUTO_TUNE_MAX_GROWTH_FACTOR:-5}"
    burst_window_ms="${_AUTO_TUNE_BURST_WINDOW_MS:-250}"

    is_nonnegint "$trim_pct" || trim_pct=10

    [ "$trim_pct" -le 40 ] || trim_pct=40

    is_posint "$pctl" || pctl=95

    [ "$pctl" -ge 50 ] || pctl=50

    [ "$pctl" -le 99 ] || pctl=99

    is_posint "$pctl_ratio" || pctl_ratio=4

    [ "$pctl_ratio" -ge 1 ] || pctl_ratio=1

    is_posint "$max_growth_factor" || max_growth_factor=5

    [ "$max_growth_factor" -ge 1 ] || max_growth_factor=1

    if ! is_posint "$burst_window_ms"; then

        log 2 "invalid ${LIGHT_GREY}_AUTO_TUNE_BURST_WINDOW_MS${YELLOW} (${LIGHT_GREY}${_AUTO_TUNE_BURST_WINDOW_MS:-}${YELLOW}); using ${LIGHT_GREY}250"

        burst_window_ms=250
    fi

    [ "$burst_window_ms" -ge 1 ] || burst_window_ms=1

    stats="$(latency_stats_file "$lat_file" "$trim_pct" "$pctl" percent 2>/dev/null || true)"

    if [ -n "$stats" ]; then
        p50_ms="$(printf '%s\n' "$stats" | awk '{print $2}')"
        pctl_ms="$(printf '%s\n' "$stats" | awk '{print $3}')"
        trimmed_n="$(printf '%s\n' "$stats" | awk '{print $4}')"

        is_posint "$p50_ms" || p50_ms=1

        is_posint "$pctl_ms" || pctl_ms="$p50_ms"

        cap_ms=$((p50_ms * pctl_ratio))

        [ "$cap_ms" -lt 1 ] && cap_ms=1

        if [ "$pctl_ms" -gt "$cap_ms" ]; then
            pctl_ms="$cap_ms"
        fi

        numer=$((_QPS * pctl_ms * 12))
        denom=$((10000 * auto_batch_effective))
        tuned_workers=$(( (numer + denom - 1) / denom ))

        [ "$tuned_workers" -lt 1 ] && tuned_workers=1

        if [ "${_FORCE_MAXIMUM:-0}" -eq 0 ]; then
            max_growth=$((_MAXIMUM * max_growth_factor))

            [ "$max_growth" -lt 1 ] && max_growth=1

            if [ "$tuned_workers" -gt "$max_growth" ]; then

                log 4 "growth cap applied: tuned_workers=${LIGHT_GREY}$tuned_workers${GREY} > max_growth=${LIGHT_GREY}$max_growth"

                tuned_workers="$max_growth"
            fi

        fi

        log 5 "elapsed=${LIGHT_GREY}${elapsed_ms}ms ${GREY}samples=${LIGHT_GREY}$done_n ${GREY}trimmed=${LIGHT_GREY}$trimmed_n ${GREY}p50=${LIGHT_GREY}${p50_ms}ms ${GREY}p${pctl}=${LIGHT_GREY}${pctl_ms}ms"

    else
        avg_ms=$(( (elapsed_ms + done_n - 1) / done_n ))

        [ "$avg_ms" -lt 1 ] && avg_ms=1

        numer=$((_QPS * avg_ms * 12))
        denom=$((10000 * auto_batch_effective))
        tuned_workers=$(( (numer + denom - 1) / denom ))

        [ "$tuned_workers" -lt 1 ] && tuned_workers=1

        log 5 "elapsed=${LIGHT_GREY}${elapsed_ms}ms ${GREY}samples=${LIGHT_GREY}$done_n ${GREY}avg=${LIGHT_GREY}${avg_ms}ms ${GREY}(fallback path)"

    fi

    tuned_burst=$(( (_QPS * burst_window_ms + 999) / 1000 ))

    [ "$tuned_burst" -lt 1 ] && tuned_burst=1

    if [ "$auto_batch_effective" -gt 1 ]; then

        [ "$tuned_burst" -lt "$auto_batch_effective" ] && \
            tuned_burst="$auto_batch_effective"

        tuned_burst=$(( ((tuned_burst + auto_batch_effective - 1) / auto_batch_effective) * auto_batch_effective ))
    fi

    if [ "${_FORCE_MAXIMUM:-0}" -eq 0 ]; then
        _MAXIMUM=$((tuned_workers > _MAXIMUM ? tuned_workers : _MAXIMUM))
    fi

    if [ "${_FORCE_BURST:-0}" -eq 0 ]; then
        _BURST=$((tuned_burst > _BURST ? tuned_burst : _BURST))
    fi

    apply_concurrency_safety_clamps

    rm -f "$lat_file" 2>/dev/null || true

    log 3 "derived _MAXIMUM=${LIGHT_GREY}$_MAXIMUM${BLUE}, _BURST=${LIGHT_GREY}$_BURST"

}

