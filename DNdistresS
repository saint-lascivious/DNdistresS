_SLEEP_FRACTIONAL_OK="${_SLEEP_FRACTIONAL_OK:--1}"

init_sleep_capability() {

    case "$_SLEEP_FRACTIONAL_OK" in
        0|1)
            return 0
            ;;
    esac

    if sleep 0.01 2>/dev/null; then
        _SLEEP_FRACTIONAL_OK=1
    else
        _SLEEP_FRACTIONAL_OK=0
    fi

}

sleep_ms() {
    ms="${1:-0}"

    case "$ms" in
        ''|*[!0-9]*)
            ms=0
            ;;
    esac

    [ "$ms" -gt 0 ] || return 0

    init_sleep_capability

    if [ "$_SLEEP_FRACTIONAL_OK" -eq 1 ]; then
        s=$((ms / 1000))
        rem=$((ms % 1000))

        if [ "$rem" -eq 0 ]; then

            sleep "$s"

        else

            sleep "$s.$(printf '%03d' "$rem")"

        fi

        return 0
    fi

    sec=$(((ms + 999) / 1000))

    [ "$sec" -ge 1 ] || sec=1

    sleep "$sec"

}

