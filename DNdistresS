json_escape() {

    if need_cmd jq; then
        printf '%s' "${1:-}" | jq -Rsa .
        return 0
    fi

    printf '%s' "${1:-}" | awk '
        BEGIN { ORS=""; print "\"" }
        {

            if (NR > 1) printf "\\n"

            s=$0
            gsub(/\\/, "\\\\", s)
            gsub(/"/, "\\\"", s)
            gsub(/\t/, "\\t", s)
            gsub(/\r/, "\\r", s)
            printf "%s", s
        }
        END { print "\"" }
    '
}

