epoch_s_posix() {
    TZ=UTC0 date '+%Y %m %d %H %M %S' | awk '

        function leap(y) {
            return ((y%4==0 && y%100!=0) || (y%400==0))
        }

        BEGIN {
            md[1]=31; md[2]=28; md[3]=31; md[4]=30; md[5]=31; md[6]=30
            md[7]=31; md[8]=31; md[9]=30; md[10]=31; md[11]=30; md[12]=31
        }
        {
            y=$1+0; m=$2+0; d=$3+0; H=$4+0; M=$5+0; S=$6+0
            days=0

            for (yy=1970; yy<y; yy++) days += leap(yy)?366:365

            for (mm=1; mm<m; mm++) {
                days += md[mm]

                if (mm==2 && leap(y)) days++

            }

            days += (d-1)
            print (days*86400 + H*3600 + M*60 + S)
        }'
}

now_ms() {
    t="$(date +%s%3N 2>/dev/null || true)"

    case "$t" in
        *[!0-9]*|'')
            t=""
            ;;
    esac

    if [ -n "$t" ]; then

        [ "$(printf '%s' "$t" | wc -c)" -eq 14 ] && {
            printf '%s\n' "$t"
            return 0
        }

        [ "$(printf '%s' "$t" | wc -c)" -eq 11 ] && {
            printf '%s000\n' "$t"
            return 0
        }

        [ "$(printf '%s' "$t" | wc -c)" -ge 20 ] && {
            printf '%s000\n' "$(printf '%s' "$t" | cut -c1-10)"
            return 0
        }

    fi

    t="$(date +%s 2>/dev/null || true)"

    case "$t" in
        *[!0-9]*|'')
            t=""
            ;;
    esac

    [ -n "$t" ] && {
        printf '%s000\n' "$t"
        return 0
    }

    t="$(epoch_s_posix)"
    printf '%s000\n' "$t"
}

