    queries_start="${QUERIES_START:-0}"

    case "$start_ms" in
        ''|*[!0-9]*)
            start_ms=0
            ;;
    esac
    
    case "$end_ms" in
        ''|*[!0-9]*)
            end_ms=0
            ;;
    esac
    
    case "$last_sent_ms" in
        ''|*[!0-9]*)
            last_sent_ms=0
            ;;
    esac
    
    case "$queries_start" in
        ''|*[!0-9]*)
            queries_start=0
            ;;
