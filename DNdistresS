pool_nth() {
    _pool_in="$1"
    _n="$2"

    case "$_n" in
        ''|*[!0-9]*|0)
            return 1
            ;;
    esac

    _i=0
    oldifs=$IFS
    IFS='
'
    for _ep in $_pool_in; do

        [ -n "$_ep" ] || continue

        _i=$((_i + 1))

        if [ "$_i" -eq "$_n" ]; then
            printf '%s\n' "$_ep"
            IFS=$oldifs
            return 0
        fi

    done

    IFS=$oldifs

    return 1
}

sample_domains_from_file() {
    f="$1"
    count="${2:-1}"
    mode="${3:-random}"

    [ -r "$f" ] || return 1

    is_posint "$count" || count=1

    [ "$count" -ge 1 ] || count=1

    case "$mode" in
        random)

            awk -v n="$count" '
                NF { a[++c] = $0 }
                END {

                    if (c < 1) exit 1

                    if (n > c) n = c

                    srand()

                    for (i=c; i>1; i--) {
                        j = int(rand() * i) + 1
                        t = a[i]; a[i] = a[j]; a[j] = t
                    }

                    for (i=1; i<=n; i++) print a[i]

                }
            ' "$f"

            ;;
        first|head)

            awk -v n="$count" 'NF{print; if (++c>=n) exit}' "$f"

            ;;
        *)
            return 1
            ;;
    esac

}

