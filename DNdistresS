finalise_worker_metrics() {
    PEAK_CONCURRENT_WORKERS=0

    [ -n "${WORKER_EVENTS_FILE:-}" ] || return 0

    [ -s "$WORKER_EVENTS_FILE" ] || return 0

    peak="$(
        sort -k2,2n -k1,1 "$WORKER_EVENTS_FILE" 2>/dev/null | awk '
            BEGIN { cur=0; peak=0 }
            $1=="+" {
                cur++

                if (cur > peak) peak=cur

                next
            }
            $1=="-" {

                if (cur > 0) cur--

                next
            }
            END { print peak+0 }
        '
    )"

    case "$peak" in
        ''|*[!0-9]*)
            peak=0
            ;;
    esac

    PEAK_CONCURRENT_WORKERS="$peak"
}

