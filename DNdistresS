stop_worker_pool() {
    mode="${1:-graceful}"
    timeout_ms="${2:-0}"

    case "$timeout_ms" in
        ''|*[!0-9]*)
            timeout_ms=0
            ;;
    esac

    force_grace_ms="${3:-250}"

    case "$force_grace_ms" in
        ''|*[!0-9]*)
            force_grace_ms=250
            ;;
    esac

    if [ -z "$WORKER_PIDS" ]; then
        w="none"
    else
        w="$WORKER_PIDS"
    fi

    log 5 "mode=${LIGHT_GREY}$mode ${GREY}timeout=${LIGHT_GREY}${timeout_ms}ms ${GREY}workers=${LIGHT_GREY}$w"

    if [ "$mode" = "graceful" ]; then
        i=1

        while [ "$i" -le "$WORKER_COUNT" ]; do
            fifo="$TMPDIR/queue.$i.fifo"
            pid="$(printf '%s\n' "$WORKER_PIDS" | awk -v n="$i" '{ print $n }')"

            if [ -p "$fifo" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                (
                    exec 8<>"$fifo" || exit 1
                    printf '%s\n' "$WORKER_STOP_TOKEN" >&8 || exit 1
                    exec 8>&-
                ) 2>/dev/null || true
            fi

            i=$((i + 1))
        done

        if [ "$timeout_ms" -gt 0 ] && [ -n "$WORKER_PIDS" ]; then
            started_wait_ms="$(mono_ms)"

            while :; do
                alive=0

                for p in $WORKER_PIDS; do

                    if kill -0 "$p" 2>/dev/null; then
                        alive=1
                        break
                    fi

                done

                [ "$alive" -eq 0 ] && break

                now_wait_ms="$(mono_ms)"
                waited_ms=$((now_wait_ms - started_wait_ms))

                if [ "$waited_ms" -ge "$timeout_ms" ]; then

                    log 2 "worker drain timeout (${LIGHT_GREY}${timeout_ms}ms${YELLOW}); forcing shutdown"

                    DRAIN_FORCED=1

                    for p in $WORKER_PIDS; do
                        kill -TERM "$p" 2>/dev/null || true
                    done

                    sleep_ms 100

                    for p in $WORKER_PIDS; do
                        kill -KILL "$p" 2>/dev/null || true
                    done

                    break
                fi

                sleep_ms 100

            done

        fi

    fi

    if [ "$mode" = "force" ]; then

        for p in $WORKER_PIDS; do
            kill -TERM "$p" 2>/dev/null || true
        done

        if [ "$force_grace_ms" -gt 0 ] && [ -n "$WORKER_PIDS" ]; then
            force_started_ms="$(mono_ms)"

            while :; do
                alive=0

                for p in $WORKER_PIDS; do

                    if kill -0 "$p" 2>/dev/null; then
                        alive=1
                        break
                    fi

                done

                [ "$alive" -eq 0 ] && break

                now_force_ms="$(mono_ms)"
                waited_force_ms=$((now_force_ms - force_started_ms))

                [ "$waited_force_ms" -ge "$force_grace_ms" ] && break

                sleep_ms 20

            done

        fi

        for p in $WORKER_PIDS; do
            kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null || true
        done

    fi

    for p in $WORKER_PIDS; do
        wait "$p" 2>/dev/null || true
    done

    for fifo in $WORKER_FIFOS; do

        rm -f "$fifo" 2>/dev/null || true

    done

    WORKER_PIDS=""
    WORKER_FIFOS=""
    WORKER_COUNT=0
    WORKER_NEXT=1
}

cleanup_all() {
    prev_rc=$?
    mode="${1:-graceful}"
    exit_code="${2:-$prev_rc}"

    case "$exit_code" in
        ''|*[!0-9]*)
            exit_code=1
            ;;
    esac

    [ "$mode" = "graceful" ] && [ "${DRAIN_FORCED:-0}" -eq 1 ] && mode="force"

    if [ "$CLEANED" -eq 0 ]; then
        CLEANED=1

        log 5 "cleanup: begin mode=${LIGHT_GREY}$mode"

        if [ -n "${FETCH_CACHE_TMP:-}" ]; then

            log 5 "cleanup: removing pending fetch temp ${LIGHT_GREY}$FETCH_CACHE_TMP"

            rm -f "$FETCH_CACHE_TMP" 2>/dev/null || true

            FETCH_CACHE_TMP=""
        fi

        stop_worker_pool "$mode"

        if [ -f "${QUERY_TYPE_FILE:-}" ]; then

            rm -f "$QUERY_TYPE_FILE" 2>/dev/null || true

        fi

        exec 3<&- || true

        if [ -n "${TMPDIR:-}" ]; then

            if [ -d "$TMPDIR" ]; then

                log 5 "cleanup: removing temp dir ${LIGHT_GREY}$TMPDIR"

                rm -fr "$TMPDIR" 2>/dev/null || {

                    log 2 "cleanup: temp dir not empty, retrying"

                    sleep_ms 100

                    rm -fr "$TMPDIR" 2>/dev/null || log 1 "cleanup: failed to remove temp dir ${LIGHT_GREY}$TMPDIR${RED}"

                }

            else

                log 5 "cleanup: temp dir already absent ${LIGHT_GREY}$TMPDIR"

            fi

        fi

        log 5 "cleanup: complete mode=${LIGHT_GREY}$mode"

        if [ "$mode" = "graceful" ] && [ "${DRAIN_FORCED:-0}" -eq 0 ] && [ "$exit_code" -eq 0 ]; then

            if [ -t 2 ] && [ "$_VERBOSITY" -ge 1 ]; then
                printf '%b\n' "${LIGHT_GREY}[${GREEN}✓${LIGHT_GREY}] ${BOLD}${GREEN}done!${NONE}"
            fi

        fi

        return 0
    fi

    log 3 "skipping cleanup"

    log 3 "cleanup already performed (mode=${LIGHT_GREY}$mode${BLUE})"

    return 0
}

format_rate_display() {
    v="${1:-0}"

    awk -v x="$v" '
        BEGIN {

            if (x !~ /^-?[0-9]+([.][0-9]+)?$/) { print x; exit }

            n = x + 0

            if (n == int(n)) {
                printf "%d\n", int(n)
                exit
            }

            s = sprintf("%.2f", n)
            sub(/0+$/, "", s)
            sub(/\.$/, "", s)
            print s
        }
    '

}

