query_one() {
    d="$1"
    qtype="${2:-$_TYPE}"
    out_file="${3:-$ANSWERS_FILE}"
    resolver_host="${4:-$RESOLVER}"
    resolver_port="${5:-$_PORT}"

    [ "${_VERBOSITY:-0}" -lt 5 ] || \
        log 5 "query: domain=${LIGHT_GREY}$d ${GREY}type=${LIGHT_GREY}$qtype ${GREY}resolver=${LIGHT_GREY}${resolver_host}#${resolver_port}"

    case "$_BINARY" in
        dig)

            # shellcheck disable=SC2086
            run_query_capture_answers "$out_file" dig @"$resolver_host" -p "$resolver_port" "$d" "$qtype" $DIG_OPTIONS_EFFECTIVE

            ;;
        nslookup)

            nslookup -port="$resolver_port" -type="$qtype" "$d" "$resolver_host" 2>/dev/null | \

            while IFS= read -r line || [ -n "$line" ]; do

                case "$line" in
                    Name:*)
                        seen=1
                        continue
                        ;;
                esac

                [ "${seen:-0}" -eq 1 ] || continue

                case "$line" in
                    Address:\ *)
                        ans=${line#Address: }
                        ;;
                    Addresses:\ *)
                        ans=${line#Addresses: }
                        ;;
                    *)
                        continue
                        ;;
                esac

                record_answer_line "$ans" "$out_file"

            done || true

            ;;
    esac

    return 0
}

query_dig_batch_file() {
    batch_file="$1"
    out_file="${2:-$ANSWERS_FILE}"
    resolver_host="${3:-$RESOLVER}"
    resolver_port="${4:-$_PORT}"

    [ -s "$batch_file" ] || return 0

    # shellcheck disable=SC2086
    run_query_capture_answers "$out_file" dig @"$resolver_host" -p "$resolver_port" -f "$batch_file" $DIG_OPTIONS_EFFECTIVE

    return 0
}

