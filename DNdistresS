        COMPLETED_QPS_WINDOW="$(awk -v c="$COMPLETED" -v ms="$queries_window_ms" 'BEGIN { printf "%.2f", c / (ms / 1000) }')"
    fi

    if [ "$script_window_ms" -gt 0 ]; then
        ANSWER_QPS_TOTAL="$(awk -v a="$ANSWERED" -v ms="$script_window_ms" 'BEGIN { printf "%.2f", a / (ms / 1000) }')"
        COMPLETED_QPS_TOTAL="$(awk -v c="$COMPLETED" -v ms="$script_window_ms" 'BEGIN { printf "%.2f", c / (ms / 1000) }')"
    fi

    return 0
}

parse_duration() {
    raw="$1"

    if is_nonnegint "$raw"; then
        printf '%s\n' "$raw"
        return 0
    fi

    result="$(printf '%s\n' "$raw" | tr '[:upper:]' '[:lower:]' | awk '
        BEGIN { total=0; ok=1 }
        {
            s=$0
            gsub(/,/, " ", s)
            gsub(/[[:space:]]+/, " ", s)
            sub(/^[[:space:]]+/, "", s)
            sub(/[[:space:]]+$/, "", s)

            if (s == "") { ok=0; exit }

            while (length(s) > 0) {

                if (s !~ /^[0-9]/) { ok=0; break }

                match(s, /^[0-9]+/)
                num = substr(s, 1, RLENGTH) + 0
                s   = substr(s, RLENGTH + 1)

                sub(/^[[:space:]]+/, "", s)

                if (s !~ /^[a-z]/) { ok=0; break }

                match(s, /^[a-z]+/)
                unit = substr(s, 1, RLENGTH)
                s    = substr(s, RLENGTH + 1)

                sub(/^[[:space:]]+/, "", s)

                if (unit == "s" || unit == "sec" || unit == "secs" \
                                || unit == "second" || unit == "seconds") {
                    total += num
                } else if (unit == "m" || unit == "min" || unit == "mins" \
                                       || unit == "minute" || unit == "minutes") {
                    total += num * 60
                } else if (unit == "h" || unit == "hr" || unit == "hrs" \
                                       || unit == "hour" || unit == "hours") {
                    total += num * 3600
                } else if (unit == "d" || unit == "day" || unit == "days") {
                    total += num * 86400
                } else if (unit == "w" || unit == "wk" || unit == "wks" \
                                       || unit == "week" || unit == "weeks") {
                    total += num * 604800
                } else if (unit == "mo" || unit == "month" || unit == "months") {
                    total += num * 2592000
                } else if (unit == "y" || unit == "yr" || unit == "yrs" \
                                       || unit == "year" || unit == "years") {
                    total += num * 31536000
                } else {
                    ok=0; break
                }

            }
        }
        END {
            if (!ok || total < 0) exit 1
            print total
        }
    ')" || return 1

    case "$result" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    printf '%s\n' "$result"
}

