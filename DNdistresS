timer_period_seconds() {

    calendar_alias_seconds() {
        raw="$1"
        raw="$(printf '%s\n' "$raw" | awk '
            {
                s=$0
                sub(/^[[:space:]]+/, "", s)
                sub(/[[:space:]]+$/, "", s)
                print tolower(s)
            }
        ')"

        case "$raw" in
            minutely)
                printf '%s\n' 60
                return 0
                ;;
            hourly)
                printf '%s\n' 3600
                return 0
                ;;
            daily)
                printf '%s\n' 86400
                return 0
                ;;
            weekly)
                printf '%s\n' 604800
                return 0
                ;;
            monthly)
                printf '%s\n' 2592000
                return 0
                ;;
            quarterly)
                printf '%s\n' 7776000
                return 0
                ;;
            semiannually)
                printf '%s\n' 15552000
                return 0
                ;;
            annually|yearly)
                printf '%s\n' 31536000
                return 0
                ;;
            *)
                return 1
                ;;
        esac

    }

    if [ -n "${_TIMER_PERIOD:-}" ]; then
        p="$(parse_duration "$_TIMER_PERIOD" 2>/dev/null || true)"

        case "$p" in
            ''|*[!0-9]*|0)
                return 1
                ;;
        esac

        printf '%s\n' "$p"
        return 0
    fi

    if need_cmd systemctl; then
        raw="$(systemctl show "${UNIT_BASE}.timer" -p OnUnitActiveUSec --value 2>/dev/null || true)"
        raw="$(printf '%s\n' "$raw" | awk '{ sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print }')"

        case "$raw" in
            ''|0) ;;
            *[!0-9]*)
                sec="$(parse_duration "$raw" 2>/dev/null || true)"

                case "$sec" in
                    ''|*[!0-9]*|0)
                        ;;
                    *)
                        printf '%s\n' "$sec"
                        return 0
                        ;;
                esac

                ;;
            *)
                sec=$(( (raw + 999999) / 1000000 ))

                [ "$sec" -gt 0 ] || return 1

                printf '%s\n' "$sec"
                return 0
                ;;
        esac

        cal_raw="$(systemctl show "${UNIT_BASE}.timer" -p OnCalendar --value 2>/dev/null || true)"
        cal_raw="$(printf '%s\n' "$cal_raw" | awk '
            {
                s=$0
                sub(/^[[:space:]]+/, "", s)
                sub(/[[:space:]]+$/, "", s)
                n=split(s, a, /[[:space:]]*;[[:space:]]*/)

                for (i=1; i<=n; i++) {

                    if (a[i] != "") { print a[i]; exit }

                }

            }
        ')"

        if sec="$(calendar_alias_seconds "$cal_raw" 2>/dev/null)"; then
            printf '%s\n' "$sec"
            return 0
        fi

    fi

    timer_file="$SERVICE_DIR/${UNIT_BASE}.timer"

    if [ -r "$timer_file" ]; then

        raw="$(awk -F= '
            /^[[:space:]]*OnUnitActiveSec[[:space:]]*=/ {
                v=$2
                sub(/^[[:space:]]+/, "", v)
                sub(/[[:space:]]+$/, "", v)
                print v
                exit
            }
        ' "$timer_file")"

        if [ -n "$raw" ]; then
            sec="$(parse_duration "$raw" 2>/dev/null || true)"

            case "$sec" in
                ''|*[!0-9]*|0)
                    ;;
                *)
                    printf '%s\n' "$sec"
                    return 0
                    ;;
            esac

        fi

        cal_raw="$(awk -F= '
            /^[[:space:]]*OnCalendar[[:space:]]*=/ {
                v=$2
                sub(/^[[:space:]]+/, "", v)
                sub(/[[:space:]]+$/, "", v)
                n=split(v, a, /[[:space:]]*;[[:space:]]*/)

                for (i=1; i<=n; i++) {

                    if (a[i] != "") { print a[i]; exit }

                }

                exit
            }
        ' "$timer_file")"

        if sec="$(calendar_alias_seconds "$cal_raw" 2>/dev/null)"; then
            printf '%s\n' "$sec"
            return 0
        fi

    fi

    return 1
}

enforce_timer_duration_guard() {

    is_running_under_own_service || return 0

    period="$(timer_period_seconds 2>/dev/null || true)"

    if [ -z "$period" ]; then

        log 3 "skipping ${LIGHT_GREY}_DURATION${YELLOW} guard"

        log 3 "service context detected while timer period is undetermined"

        return 0
    fi

    if [ "$_DURATION" -eq 0 ]; then

        log 2 "${LIGHT_GREY}_DURATION${YELLOW} too low for timer (${LIGHT_GREY}$_DURATION${YELLOW}), setting to timer period (${LIGHT_GREY}$period${YELLOW})"

        _DURATION="$period"
        return 0
    fi

    if [ "$_DURATION" -gt "$period" ]; then

        log 2 "_DURATION too high for timer (${LIGHT_GREY}$_DURATION${YELLOW}), setting to timer period (${LIGHT_GREY}$period${YELLOW})"

        _DURATION="$period"
        return 0
    fi

}

