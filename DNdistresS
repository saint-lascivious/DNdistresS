        if [ "$COMPLETED_QPS_WINDOW_DISP" != "$COMPLETED_QPS_TOTAL_DISP" ]; then

            rr_line "completed QPS (window):" "$COMPLETED_QPS_WINDOW_DISP"

            rr_line "completed QPS (total):" "$COMPLETED_QPS_TOTAL_DISP"

        else

            rr_line "completed QPS:" "$COMPLETED_QPS_WINDOW_DISP"

        fi

    fi

    if [ "$ANSWERED" -gt 0 ]; then

        if [ "$ANSWER_QPS_WINDOW_DISP" != "$ANSWER_QPS_TOTAL_DISP" ]; then

            rr_line "answer QPS (window):" "$ANSWER_QPS_WINDOW_DISP"

            rr_line "answer QPS (total):" "$ANSWER_QPS_TOTAL_DISP"

        else

            rr_line "answer QPS:" "$ANSWER_QPS_WINDOW_DISP"

        fi

    fi

    rr_ts_line "last query sent:" "$last_sent_ms"

    rr_ts_line "script end:" "$end_ms"

    rr_line "total runtime:" "$SCRIPT_WINDOW_HUMAN"

    rr_line "query window:" "$QUERIES_WINDOW_HUMAN"

    rr_line "active query time:" "$ACTIVE_HUMAN"

    return 0
}

on_exit_trap() {
    rc="${1:-$?}"

    trap - EXIT
    set +e

    if [ "$rc" -eq "$EXIT_ABORT" ] && [ "${ABORT_HANDLED:-0}" -eq 0 ]; then

        log 3 "exit trap saw abort status without signal trap path; running fallback abort report"

        stop_worker_pool graceful 250 || true

        merge_answer_shards || true

        sum_completed_shards || true

        finalise_worker_metrics || true

        END_MS="$(now_ms)"

        if [ "${_VERBOSITY:-0}" -gt 0 ]; then

            show_runtime_report >&2 || true

        fi

        cleanup_all force "$rc" || true

        return 0
    fi

    cleanup_all graceful "$rc" || true

    return 0
}

on_abort() {
    trap - INT TERM HUP
    trap - EXIT
    set +e

    ABORT_HANDLED=1

    if [ "${_VERBOSITY:-0}" -gt 0 ]; then

        if [ -t 2 ]; then
            printf '\n' >&2
        elif [ -t 1 ]; then
            printf '\n'
        fi

    fi

    log 3 "abort signal caught, forcing cleanup"

    stop_worker_pool graceful 250 || true

    merge_answer_shards || true

    sum_completed_shards || true

    finalise_worker_metrics || true

    END_MS="$(now_ms)"

    if [ "${_VERBOSITY:-0}" -gt 0 ]; then

        show_runtime_report >&2 || true

    fi

    cleanup_all force "$EXIT_ABORT" || true

    exit_with_status "$EXIT_ABORT"

}

