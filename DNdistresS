    [ "$start_ms" -gt 0 ] || start_ms="$SCRIPT_START"
    
    [ "$end_ms" -gt 0 ] || end_ms="$(now_ms)"
    
    [ "$queries_start" -gt 0 ] || queries_start="$start_ms"

