            ;;
    esac

    printf '%s\n' "$t" >> "$QUERY_TYPE_FILE"
}

init_random_rr_pool() {
    old_ifs=$IFS
    IFS=' '
    # shellcheck disable=SC2086
    set -- $RANDOM_RR_POOL
    IFS=$old_ifs
    RANDOM_POOL_COUNT=$#

    [ "$RANDOM_POOL_COUNT" -gt 0 ] || RANDOM_POOL_COUNT=1

    seed="$(now_ms)"

    case "$seed" in
        ''|*[!0-9]*)
            seed=1
            ;;
    esac

    RAND_STATE=$(( (seed + $$) % 2147483647 ))

    [ "$RAND_STATE" -gt 0 ] || RAND_STATE=1

}

init_fast_rand_state() {
    [ "${FAST_RAND_READY:-0}" -eq 0 ] || return 0

    seed="$(now_ms)"

    case "$seed" in
        ''|*[!0-9]*)
            seed=1
            ;;
    esac

    FAST_RAND_STATE=$(( (seed + $$ + RAND_STATE) % 2147483647 ))

    [ "$FAST_RAND_STATE" -gt 0 ] || FAST_RAND_STATE=1

    FAST_RAND_READY=1
}

rand_next_u31() {

    init_fast_rand_state

    FAST_RAND_STATE=$(( (FAST_RAND_STATE * 1103515245 + 12345) % 2147483647 ))

    [ "$FAST_RAND_STATE" -gt 0 ] || FAST_RAND_STATE=1

    printf '%s\n' "$FAST_RAND_STATE"
}

rand_int_range_fast() {
    min="$1"
    max="$2"

    is_posint "$min" || return 1

    is_posint "$max" || return 1

    [ "$max" -ge "$min" ] || return 1

    span=$((max - min + 1))
    r="$(rand_next_u31 2>/dev/null || true)"

    case "$r" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    printf '%s\n' $((min + (r % span)))
}

pick_query_type() {

    if [ "${_RANDOM:-0}" -ne 1 ]; then
        PICKED_QTYPE="$_TYPE"
        return 0
    fi

    [ "$RANDOM_POOL_COUNT" -gt 0 ] || init_random_rr_pool

    RAND_STATE=$(( (RAND_STATE * 1103515245 + 12345) % 2147483647 ))
    idx=$(( (RAND_STATE % RANDOM_POOL_COUNT) + 1 ))

    i=1

    for t in $RANDOM_RR_POOL; do

        if [ "$i" -eq "$idx" ]; then
            PICKED_QTYPE="$t"
            return 0
        fi

        i=$((i + 1))
    done

    PICKED_QTYPE="$_TYPE"

}

record_answer_line() {
    line="$1"
    out_file="${2:-$ANSWERS_FILE}"

    printf '%s\n' "$line" >> "$out_file"

    if [ "$_OUTPUT" = "answer" ] && [ -n "$line" ]; then
        printf '   %b•%b %s\n' "$GREY" "$NONE" "$line"
