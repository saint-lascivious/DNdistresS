}

mono_ms() {

    if [ -r /proc/uptime ] && IFS=' ' read -r up _ < /proc/uptime; then
        up=${up%% *}
        sec=${up%%.*}
        frac=${up#*.}

        [ "$frac" = "$up" ] && frac=0

        case "$frac" in
            '')
                frac3=000
                ;;
            ?)
                frac3="${frac}00"
                ;;
            ??)
                frac3="${frac}0"
                ;;
            *)
                frac3=$(printf '%.3s' "$frac")
                ;;
        esac

        case "$sec$frac3" in
            ''|*[!0-9]*)
                ;;
            *)
                sec_dec="$(printf '%d' "$sec" 2>/dev/null || printf '0')"
                frac3_dec="$(printf '%d' "$frac3" 2>/dev/null || printf '0')"
                printf '%s\n' $((sec_dec * 1000 + frac3_dec))
                return 0
                ;;
        esac

    fi

    now_ms
}

start_worker_pool() {
    workers="$1"

    WORKER_COUNT="$workers"
    WORKER_PIDS=""
    WORKER_FIFOS=""
    WORKER_NEXT=1
    ANSWER_SHARDS=""
    COMPLETED_SHARDS=""

    log 5 "workers=${LIGHT_GREY}$workers"

    i=1

    while [ "$i" -le "$workers" ]; do
        fifo="$TMPDIR/queue.$i.fifo"
        shard="$TMPDIR/answers.$i.txt"
        cshard="$TMPDIR/completed.$i.count"

        rm -f "$fifo"

        mkfifo "$fifo" || {

            log 0 "failed to create worker fifo: ${LIGHT_GREY}$fifo"

            return 1
        }

        : > "$shard"
        : > "$cshard"
        ANSWER_SHARDS="${ANSWER_SHARDS:+$ANSWER_SHARDS }$shard"
        COMPLETED_SHARDS="${COMPLETED_SHARDS:+$COMPLETED_SHARDS }$cshard"
        WORKER_FIFOS="${WORKER_FIFOS:+$WORKER_FIFOS }$fifo"

        (
            set +e
            exec 7<> "$fifo" || exit 1
            worker_completed=0

            worker_flush_completed() {
                printf '%s\n' "${worker_completed:-0}" > "$cshard"
            }

            trap 'worker_flush_completed; exit 0' TERM INT HUP
            trap 'worker_flush_completed' EXIT

            while IFS= read -r job <&7; do

                [ -n "$job" ] || continue

                [ "$job" = "$WORKER_STOP_TOKEN" ] && break

                case "$job" in
                    "${DIG_BATCH_PREFIX}"'|'*'|'*'|'*'|'*)
                        payload=${job#*|}
                        batch_count=${payload%%|*}
                        payload=${payload#*|}
                        batch_file=${payload%%|*}
                        payload=${payload#*|}
                        batch_host=${payload%%|*}
                        batch_port=${payload#*|}
                        ;;
                    "${DIG_BATCH_PREFIX}"'|'*'|'*)
                        payload=${job#*|}
                        batch_count=${payload%%|*}
                        batch_file=${payload#*|}
                        batch_host="$RESOLVER"
                        batch_port="$_PORT"
                        ;;
                    "${DIG_BATCH_PREFIX}"'|'*)
                        batch_file=${job#*|}
                        batch_count=0
                        batch_host="$RESOLVER"
                        batch_port="$_PORT"
                        ;;
                esac

                case "$job" in
                    "${DIG_BATCH_PREFIX}"'|'*)

                        [ -n "$batch_file" ] || continue

                        case "$batch_count" in
                            ''|*[!0-9]*)
                                batch_count=0
                                ;;
                        esac

                        worker_event_mark "+"

                        query_dig_batch_file "$batch_file" "$shard" "$batch_host" "$batch_port" || true

                        rm -f "$batch_file" 2>/dev/null || true

                        worker_event_mark "-"

                        worker_completed=$((worker_completed + batch_count))
                        continue
                        ;;
                esac

                case "$job" in
                    *'|'*'|'*'|'*)
                        qtype=${job%%|*}
                        rem=${job#*|}
                        d=${rem%%|*}
                        rem=${rem#*|}
                        job_resolver=${rem%%|*}
                        job_port=${rem#*|}
                        ;;
                    *'|'*)
                        qtype=${job%%|*}
                        d=${job#*|}
                        job_resolver="$RESOLVER"
                        job_port="$_PORT"
                        ;;
                    *)
                        qtype="$_TYPE"
                        d="$job"
                        job_resolver="$RESOLVER"
                        job_port="$_PORT"
                        ;;
                esac

                [ -n "$d" ] || continue

                worker_event_mark "+"

                query_one "$d" "$qtype" "$shard" "$job_resolver" "$job_port" || true

                worker_event_mark "-"

                worker_completed=$((worker_completed + 1))
            done

            worker_flush_completed

            exec 7<&-
        ) &

        pid="$!"
        WORKER_PIDS="${WORKER_PIDS:+$WORKER_PIDS }$pid"

        log 5 "started worker pid=${LIGHT_GREY}$pid${GREY} fifo=${LIGHT_GREY}$fifo"

        i=$((i + 1))
    done

    return 0
}

