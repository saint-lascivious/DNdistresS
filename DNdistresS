compute_dispatch_profile() {
    _mode="$1"
    _pool="$(pool_get "$_mode")"
    _count="$(pool_count "$_pool")"

    [ "$_count" -gt 0 ] || return 1

    DISPATCH_FANOUT=1
    DISPATCH_TOKEN_COST=1
    DISPATCH_BURST_LOGICAL="$_BURST"
    DIG_BATCH_LOGICAL_SIZE_EFFECTIVE="${_DIG_BATCH_SIZE_EFFECTIVE:-$_DIG_BATCH_SIZE}"

    case "$DISPATCH_BURST_LOGICAL" in
        ''|*[!0-9]*|0)
            DISPATCH_BURST_LOGICAL=1
            ;;
    esac

    case "$DIG_BATCH_LOGICAL_SIZE_EFFECTIVE" in
        ''|*[!0-9]*|0)
            DIG_BATCH_LOGICAL_SIZE_EFFECTIVE=1
            ;;
    esac

    if [ "$_RESOLVER_STRATEGY" = "parallel" ]; then
        DISPATCH_FANOUT="$_count"
        DISPATCH_TOKEN_COST="$_count"

        if [ "$_BURST" -lt "$DISPATCH_TOKEN_COST" ]; then

            log 2 "${LIGHT_GREY}_BURST${YELLOW} (${LIGHT_GREY}$_BURST${YELLOW}) is too low for mirrored parallel fanout (${LIGHT_GREY}$DISPATCH_TOKEN_COST${YELLOW}); raising burst minimum"

            _BURST="$DISPATCH_TOKEN_COST"
            _BURST_EFFECTIVE="$_BURST"
        fi

        if [ "${_DIG_BATCH:-0}" -eq 1 ] && [ "$_DIG_BATCH_SIZE_EFFECTIVE" -lt "$DISPATCH_TOKEN_COST" ]; then

            log 2 "${LIGHT_GREY}_DIG_BATCH_SIZE_EFFECTIVE${YELLOW} (${LIGHT_GREY}$_DIG_BATCH_SIZE_EFFECTIVE${YELLOW}) is too low for mirrored parallel fanout (${LIGHT_GREY}$DISPATCH_TOKEN_COST${YELLOW}); raising minimum"

            _DIG_BATCH_SIZE_EFFECTIVE="$DISPATCH_TOKEN_COST"
        fi

        DISPATCH_BURST_LOGICAL=$((_BURST / DISPATCH_TOKEN_COST))

        [ "$DISPATCH_BURST_LOGICAL" -ge 1 ] || DISPATCH_BURST_LOGICAL=1

        DIG_BATCH_LOGICAL_SIZE_EFFECTIVE=$((_DIG_BATCH_SIZE_EFFECTIVE / DISPATCH_TOKEN_COST))

        [ "$DIG_BATCH_LOGICAL_SIZE_EFFECTIVE" -ge 1 ] || DIG_BATCH_LOGICAL_SIZE_EFFECTIVE=1

    fi

    log 4 "dispatch profile: fanout=${LIGHT_GREY}$DISPATCH_FANOUT${GREY} token_cost=${LIGHT_GREY}$DISPATCH_TOKEN_COST${GREY} logical_burst=${LIGHT_GREY}$DISPATCH_BURST_LOGICAL${GREY} logical_batch=${LIGHT_GREY}$DIG_BATCH_LOGICAL_SIZE_EFFECTIVE"

    return 0
}

