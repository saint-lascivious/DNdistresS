pick_resolver_endpoint() {
    _mode="$1"
    _pool="$(pool_get "$_mode")"
    _count="$(pool_count "$_pool")"

    [ "$_count" -gt 0 ] || return 1

    case "$_RESOLVER_STRATEGY" in
        rr)

            if [ "$_mode" = "local" ]; then

                [ "$_LOCAL_RR_INDEX" -le "$_count" ] || _LOCAL_RR_INDEX=1

                _pick="$(pool_nth "$_pool" "$_LOCAL_RR_INDEX")"
                _LOCAL_RR_INDEX=$((_LOCAL_RR_INDEX + 1))
            else

                [ "$_REMOTE_RR_INDEX" -le "$_count" ] || _REMOTE_RR_INDEX=1

                _pick="$(pool_nth "$_pool" "$_REMOTE_RR_INDEX")"
                _REMOTE_RR_INDEX=$((_REMOTE_RR_INDEX + 1))
            fi

            ;;
        fastest)
            _pick="$(pool_nth "$_pool" 1)"
            ;;
        random)
            _idx="$(rand_int_range_fast 1 "$_count" 2>/dev/null || printf '1\n')"
            _pick="$(pool_nth "$_pool" "$_idx")"
            ;;
        *)
            return 1
            ;;
    esac

    [ -n "$_pick" ] || return 1

    printf '%s\n' "$_pick"
