require_safe_unit_token() {
    label="$1"
    val="$2"

    [ -n "$val" ] || {

        log 1 "unsafe systemd field for ${LIGHT_GREY}${label}${RED}: ${LIGHT_GREY}${val}"

        log 3 "rejecting control characters/whitespace in unquoted unit fields"

        return 1
    }

    orig_n="$(printf '%s' "$val" | wc -c | tr -d ' ')"
    clean_n="$(printf '%s' "$val" | LC_ALL=C tr -d '\000-\037\177' | wc -c | tr -d ' ')"

    if [ "$orig_n" -ne "$clean_n" ]; then

        log 1 "unsafe systemd field for ${LIGHT_GREY}${label}${RED}: ${LIGHT_GREY}${val}"

        log 3 "rejecting control characters/whitespace in unquoted unit fields"

        return 1
    fi

    case "$val" in
        *[[:space:]]*)

            log 1 "unsafe systemd field for ${LIGHT_GREY}${label}${RED}: ${LIGHT_GREY}${val}"

            log 3 "rejecting control characters/whitespace in unquoted unit fields"

            return 1
            ;;
    esac

    return 0
}

self_source_path() {
    p="$0"

    if [ ! -f "$p" ]; then
        p="$(command -v "$0" 2>/dev/null || true)"
    fi

    [ -n "$p" ] || return 1

    [ -f "$p" ] || return 1

    if need_cmd realpath; then
        ap="$(realpath "$p" 2>/dev/null || true)"

        [ -n "$ap" ] && [ -f "$ap" ] && { printf '%s\n' "$ap"; return 0; }

    fi

    if need_cmd readlink; then
        ap="$(readlink -f "$p" 2>/dev/null || true)"

        [ -n "$ap" ] && [ -f "$ap" ] && { printf '%s\n' "$ap"; return 0; }

    fi

    d="${p%/*}"
    b="${p##*/}"

    [ "$d" = "$p" ] && d="."

    dabs="$(cd "$d" 2>/dev/null && pwd -P)" || return 1

    [ -n "$dabs" ] || return 1

    ap="$dabs/$b"

    [ -f "$ap" ] || return 1

    printf '%s\n' "$ap"
}

as_root_or_sudo() {

    [ "$(id -u)" -eq 0 ] && return 0

    if need_cmd sudo; then
        self_exec="$(self_source_path 2>/dev/null || true)"

        [ -n "$self_exec" ] || {

            log 1 "unable to resolve absolute script path for sudo re-exec"

            return 1
