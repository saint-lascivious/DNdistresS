                _PORT="$2"
                shift 2
                ;;
            -q|q|--qps|qps)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                _QPS="$2"
                shift 2
                ;;
            -R|R|--random|random)
                SEEN_NONEXCLUSIVE=1
                SEEN_RANDOM=1
                _RANDOM=1
                shift
                ;;
            --auto-tune|auto-tune)
                SEEN_NONEXCLUSIVE=1
                _AUTO_TUNE=1
                shift
                ;;
            -r|r|--remote|remote)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                parse_resolver_cli_arg "remote" "$1" "$2" || exit_with_status "$EXIT_USAGE"

                shift 2
                ;;
            --resolver-strategy|resolver-strategy)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                _RESOLVER_STRATEGY="$2"
                shift 2
                ;;
            --resolver-strategy=*|resolver-strategy=*)
                SEEN_NONEXCLUSIVE=1
                _RESOLVER_STRATEGY="${1#*=}"
                shift
                ;;
            -s|s|--seconds|seconds)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                _SECONDS="$2"
                shift 2
                ;;
            -t|t|--top|top)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                _t_a="$2"
                shift 2

                _t_extras=""

                while [ "$#" -gt 0 ]; do

                    case "$1" in
                        -*)
                            break
                            ;;
                        /*|'||'*|^*|.*|*[!0-9]*)
                            _t_extras="${_t_extras:+$_t_extras }$1"
                            shift
                            ;;
                        [1-9]*)

                            case "$_t_a" in
                                .*|^*|'||'*|/*)
                                    _t_extras="${_t_extras:+$_t_extras }$1"
                                    shift
                                    ;;
                                *)
                                    break
                                    ;;
                            esac

                            ;;
                        *)
                            break
                            ;;
                    esac

                done

                _top_parsed="$(
                    set -f

                    # shellcheck disable=SC2086
                    parse_top_opt "$_t_a" $_t_extras

                )" || exit_with_status "$EXIT_USAGE"

                _TOP="$(printf '%s\n' "$_top_parsed" | sed -n '1p')"
                _TOP_FILTERS="$(printf '%s\n' "$_top_parsed" | sed -n '2p')"
                ;;
            -T|T|--type|type)
                SEEN_NONEXCLUSIVE=1
                SEEN_TYPE=1

                need_optarg "$1" "$@"

                _TYPE="$2"
                shift 2
                ;;
            -u|u|--uninstall|uninstall)

                set_mode "uninstall"

                if [ "$#" -ge 2 ] && [ "${2#-}" = "$2" ]; then

                    case "$2" in
                        V|verbosity)
                            shift
                            ;;
                        *)
                            _UNINSTALL="$2"
                            shift 2
                            ;;
                    esac

                else
                    shift
                fi

                ;;
            --with-systemd)
                WITH_SYSTEMD_SEEN=1
                _WITH_SYSTEMD=1
                shift
                ;;
            --without-systemd)
                WITH_SYSTEMD_SEEN=1
                _WITH_SYSTEMD=0
                shift
                ;;
            --with-bash-completion)
                WITH_BASH_COMPLETION_SEEN=1
                _WITH_BASH_COMPLETION=1
                shift
                ;;
            --without-bash-completion)
                WITH_BASH_COMPLETION_SEEN=1
                _WITH_BASH_COMPLETION=0
                shift
                ;;
            --purge|purge)
                _PURGE=1
                shift
                ;;
            -U|U|--url|url)
                SEEN_NONEXCLUSIVE=1

                need_optarg "$1" "$@"

                _URL="$2"
                shift 2
                ;;
            -V|V|--verbosity|verbosity)

                need_optarg "$1" "$@"

                _VERBOSITY="$2"
                shift 2
                ;;
            -V=*|V=*|--verbosity=*|verbosity=*)
                _VERBOSITY="${1#*=}"
                shift
                ;;
            --)
                shift
                break
                ;;
            *)

                log 1 "unexpected positional argument(s): ${LIGHT_GREY}$*"

                exit_with_status "$EXIT_USAGE"

                ;;
        esac

    done

    [ "$#" -eq 0 ] || {

        log 1 "unexpected positional argument(s): ${LIGHT_GREY}$*"

        exit_with_status "$EXIT_USAGE"

    }

    validate_verbosity

    if [ "$SEEN_RANDOM" -eq 1 ] && [ "$SEEN_TYPE" -eq 1 ]; then

        log 1 "${LIGHT_GREY}--random${RED} and ${LIGHT_GREY}--type${RED} are mutually exclusive"

        log 3 "use ${LIGHT_GREY}--type <RR>${BLUE} for fixed RR traffic, or ${LIGHT_GREY}--random${BLUE} (optionally with ${LIGHT_GREY}_RANDOM_RR_POOL${BLUE}) for mixed RR traffic"

        exit_with_status "$EXIT_USAGE"

    fi

    if [ "$SEEN_L" -eq 1 ] && [ "$SEEN_R" -eq 1 ]; then

        if [ "$_LOCATION_EXPLICIT" -eq 0 ]; then

            log 1 "use only one of ${LIGHT_GREY}-l${RED}|${LIGHT_GREY}-r${RED}, or set ${LIGHT_GREY}--location local${RED}|${LIGHT_GREY}remote${RED} explicitly"

            exit_with_status "$EXIT_USAGE"

        fi

        case "$_LOCATION" in
            local|remote)

                log 4 "both ${LIGHT_GREY}-l${GREY} and ${LIGHT_GREY}-r${GREY} provided with explicit ${LIGHT_GREY}--location $_LOCATION"

                ;;
            auto)

                log 1 "when both ${LIGHT_GREY}-l${RED} and ${LIGHT_GREY}-r${RED} are provided, ${LIGHT_GREY}--location${RED} must be ${LIGHT_GREY}local${RED} or ${LIGHT_GREY}remote"

                exit_with_status "$EXIT_USAGE"

                ;;
        esac

    fi

    invalid_mode_scope=0

    if [ "$FULL_SEEN" -eq 1 ]; then

        case "$_MODE" in
            install)
                _WITH_SYSTEMD=1
                _WITH_BASH_COMPLETION=1
                ;;
            *)

                log 1 "${LIGHT_GREY}--full${RED} only applies to install"

                invalid_mode_scope=1
                ;;
        esac

    fi

    if [ "$WITH_SYSTEMD_SEEN" -eq 1 ]; then

        case "$_MODE" in
            install|uninstall)
                ;;
            *)

                log 1 "${LIGHT_GREY}--with-systemd${RED}/${LIGHT_GREY}--without-systemd${RED} only apply to ${LIGHT_GREY}install${RED}/${LIGHT_GREY}uninstall"

                invalid_mode_scope=1
                ;;
        esac

    fi

    if [ "$WITH_BASH_COMPLETION_SEEN" -eq 1 ]; then

        case "$_MODE" in
            install|uninstall)
                ;;
            *)

                log 1 "${LIGHT_GREY}--with-bash-completion${RED}/${LIGHT_GREY}--without-bash-completion${RED} only apply to ${LIGHT_GREY}install${RED}/${LIGHT_GREY}uninstall"

                invalid_mode_scope=1
                ;;
        esac

    fi

    if [ "$_PURGE" -eq 1 ]; then

        case "$_MODE" in
            uninstall)
                ;;
            *)

                log 1 "${LIGHT_GREY}--purge${RED} only applies to uninstall"

                invalid_mode_scope=1
                ;;
        esac

    fi

    [ "$invalid_mode_scope" -eq 0 ] || exit_with_status "$EXIT_USAGE"

    case "$_MODE" in
        version)

            [ "$SEEN_NONEXCLUSIVE" -eq 0 ] || {

                log 1 "${LIGHT_GREY}version${RED} cannot be combined with other options"

                exit_with_status "$EXIT_USAGE"

            }

            print_version

            exit 0
            ;;
        show)

            [ "$SEEN_NONEXCLUSIVE" -eq 0 ] || {

                log 1 "${LIGHT_GREY}show${RED} cannot be combined with other options"

                exit_with_status "$EXIT_USAGE"

            }

            [ -n "$SHOW_TOPIC" ] || {

                printf '%s\n' "Usage: ${0##*/} show {w|c|warranty|conditions}" >&2

                exit_with_status "$EXIT_USAGE"

            }

            run_show_topic "$SHOW_TOPIC"

            ;;
        install)

            [ "$SEEN_NONEXCLUSIVE" -eq 0 ] || {

                log 1 "${LIGHT_GREY}install${RED} cannot be combined with other options"

                exit_with_status "$EXIT_USAGE"

            }

            do_install "$_INSTALL"

            exit 0
            ;;
        uninstall)

            [ "$SEEN_NONEXCLUSIVE" -eq 0 ] || {

                log 1 "${LIGHT_GREY}uninstall${RED} cannot be combined with other options"

                exit_with_status "$EXIT_USAGE"

            }

            do_uninstall "$_UNINSTALL"

            exit 0
            ;;
    esac

    TMPROOT="${TMPDIR:-/tmp}"
    TMPDIR="$(make_tmpdir "$TMPROOT")" || {

        log 0 "failed to create temp dir in ${LIGHT_GREY}$TMPROOT"

        exit_with_status "$EXIT_RUNTIME"

    }

    log 5 "created temp dir: ${LIGHT_GREY}$TMPDIR"

    trap 'on_exit_trap "$?"' EXIT
    trap 'on_abort' INT TERM HUP

    ANSWERS_FILE="$TMPDIR/answers.txt"
    QUERY_TYPE_FILE="$TMPDIR/query_types.txt"
    WORKER_EVENTS_FILE="$TMPDIR/worker.events"
    : > "$WORKER_EVENTS_FILE"

    is_port "$_PORT" || {

        log 1 "${LIGHT_GREY}_PORT${RED} must be one (${LIGHT_GREY}1${RED}) of ${LIGHT_GREY}1${RED}|${LIGHT_GREY}...${RED}|${LIGHT_GREY}65535${RED}, got: ${LIGHT_GREY}$_PORT"

        exit_with_status "$EXIT_USAGE"

    }

    require_posint "_TOP" "$_TOP"

    [ -n "$_TOP_FILTERS" ] && \
        log 4 "active filters: ${LIGHT_GREY}$_TOP_FILTERS"

    require_posint "_BURST" "$_BURST"

    require_posint "_MAXIMUM" "$_MAXIMUM"

    require_posint "_QPS" "$_QPS"

    require_posint "_CLOCK_TICK_MS" "$_CLOCK_TICK_MS"

    require_posint "_DIG_BATCH_SIZE" "$_DIG_BATCH_SIZE"

    require_nonnegint "_DRAIN_TIMEOUT_MS" "$_DRAIN_TIMEOUT_MS"

    require_nonnegint "_COLUMN" "$_COLUMN"

    require_nonnegint "_MAX_DOMAINS_LINES" "$_MAX_DOMAINS_LINES"

    _DURATION_RAW="$_DURATION"

    _DURATION="$(parse_duration "$_DURATION_RAW")" || {

        log 1 "invalid ${LIGHT_GREY}_DURATION${RED} (use seconds or e.g. ${LIGHT_GREY}1h${RED}, ${LIGHT_GREY}2d 14h 27m 52s${RED})"

        exit_with_status "$EXIT_USAGE"

    }

    _SECONDS_RAW="$_SECONDS"

    _SECONDS="$(parse_duration "$_SECONDS_RAW")" || {

        log 1 "invalid ${LIGHT_GREY}_SECONDS${RED} (use seconds or e.g. ${LIGHT_GREY}1h${RED}, ${LIGHT_GREY}2d 14h 27m 52s${RED})"

        exit_with_status "$EXIT_USAGE"

    }

    enforce_timer_duration_guard

    apply_concurrency_safety_clamps

    case "$_FORMAT" in
        auto|plain|csv)
            ;;
        *)

            log_invalid_enum "_FORMAT" "$_FORMAT" auto plain csv

            exit_with_status "$EXIT_USAGE"

            ;;
    esac

    case "$_OUTPUT" in
        quiet|answer)
            ;;
        *)

            log_invalid_enum "_OUTPUT" "$_OUTPUT" quiet answer

            exit_with_status "$EXIT_USAGE"

            ;;
    esac

    case "$_LOCATION" in
        auto|local|remote)
            ;;
        *)

            log_invalid_enum "_LOCATION" "$_LOCATION" auto local remote

            exit_with_status "$EXIT_USAGE"

            ;;
    esac

    case "$_RESOLVER_STRATEGY" in
        rr|random|fastest|parallel)
            ;;
        *)

            log_invalid_enum "_RESOLVER_STRATEGY" "$_RESOLVER_STRATEGY" rr random fastest parallel

            exit_with_status "$EXIT_USAGE"

            ;;
    esac

    _TYPE="$(printf '%s' "$_TYPE" | tr '[:lower:]' '[:upper:]')"
    _TYPE_ID=""

    case "$_TYPE" in
        ANY)

            if [ "${_DENY_ANY:-1}" -eq 1 ]; then

                log 1 "${LIGHT_GREY}ANY ${RED}is not allowed by default; use ${LIGHT_GREY}--allow-any ${RED}to permit it (RR type ${LIGHT_GREY}255${RED})"

                exit_with_status "$EXIT_USAGE"

            fi

            ;;
        TYPE[0-9]*)
            _TYPE_ID="${_TYPE#TYPE}"
            ;;
        [0-9]*)
            _TYPE_ID="$_TYPE"
            ;;
    esac

    if [ -n "$_TYPE_ID" ]; then

        case "$_TYPE_ID" in
            ''|*[!0-9]*)

                log 1 "invalid _TYPE=${LIGHT_GREY}$_TYPE${RED} (must be a valid mnemonic or numeric RR type ID)"

                exit_with_status "$EXIT_USAGE"

                ;;
        esac

        [ "$_TYPE_ID" -ge 1 ] && [ "$_TYPE_ID" -le 65535 ] || {

            log 1 "${LIGHT_GREY}_TYPE${RED} RR ID must be one (${LIGHT_GREY}1${RED}) of ${LIGHT_GREY}1${RED}|${LIGHT_GREY}...${RED}|${LIGHT_GREY}65535${RED}, got: ${LIGHT_GREY}$_TYPE_ID"

            exit_with_status "$EXIT_USAGE"

        }

        [ "$_TYPE_ID" -ne 255 ] || {

            if [ "${_DENY_ANY:-1}" -eq 1 ]; then

                log 1 "${LIGHT_GREY}_TYPE${RED} RR ID ${LIGHT_GREY}255 ${RED}(${LIGHT_GREY}ANY${RED}) is not allowed by default; use ${LIGHT_GREY}--allow-any ${RED}to permit it"

                exit_with_status "$EXIT_USAGE"

            fi

        }

        _TYPE_MN="$(rr_type_from_id "$_TYPE_ID" 2>/dev/null || true)"

        [ -n "$_TYPE_MN" ] || {

            log 1 "unsupported RR type ID: ${LIGHT_GREY}$_TYPE_ID${RED} (no mnemonic found)"

            log 3 "tip, use a mnemonic (like ${LIGHT_GREY}A${BLUE}/${LIGHT_GREY}AAAA${BLUE}/${LIGHT_GREY}MX${BLUE}/${LIGHT_GREY}TXT${BLUE}) for uncommon RR types"

            exit_with_status "$EXIT_USAGE"

        }

        _TYPE="$_TYPE_MN"
    fi

    choose_tool || {

        case "$_BINARY" in
            auto|dig|nslookup)

                exit_with_status "$EXIT_DEPENDENCY"

                ;;
            *)

                exit_with_status "$EXIT_USAGE"

                ;;
        esac

    }

    if [ "$_DIG_OPTIONS_SET" -eq 1 ] && [ "$_BINARY" = "nslookup" ]; then

        if [ "$_STRICT_DIG_OPTIONS" -eq 1 ]; then

            log 1 "${LIGHT_GREY}--dig-options${RED} was provided but selected binary is ${LIGHT_GREY}nslookup"

            log 1 "refusing to continue (${LIGHT_GREY}_STRICT_DIG_OPTIONS=1${RED})"

            exit_with_status "$EXIT_USAGE"

        fi

        log 2 "${LIGHT_GREY}--dig-options${YELLOW} provided, but selected binary is ${LIGHT_GREY}nslookup"

        log 2 "ignoring dig options for this run"

    fi

    validate_and_build_dig_options || exit_with_status "$EXIT_USAGE"

    if [ "$_DIG_BATCH" -eq 1 ] && [ "$_BINARY" != "dig" ]; then

        log 2 "${LIGHT_GREY}--batch${YELLOW} requested, but selected binary is ${LIGHT_GREY}$_BINARY"

        log 2 "disabling batching for this run"

        _DIG_BATCH=0
    fi

    if [ -z "$_REMOTE" ]; then
        _REMOTE="$_LOCAL"

        log 4 "_REMOTE remains unset; using _LOCAL=${LIGHT_GREY}$_LOCAL"

    fi

    [ -n "$_LOCAL_POOL" ] || append_pool_unique local "${_LOCAL}#${_PORT}"

    [ -n "$_REMOTE_POOL" ] || append_pool_unique remote "${_REMOTE}#${_PORT}"

    case "$_LOCATION" in
        auto)

            if [ "$SEEN_R" -eq 1 ]; then
                ACTIVE_LOCATION="remote"
            else
                ACTIVE_LOCATION="local"
            fi

            ;;
        local)
            ACTIVE_LOCATION="local"
            ;;
        remote)
            ACTIVE_LOCATION="remote"
            ;;
    esac

    case "$ACTIVE_LOCATION" in
        local)

            if [ "$_LOCATION_FORCED" -eq 1 ]; then

                validate_pool_for_mode local dns || {

                    log 1 "invalid local resolver pool in forced local mode"

                    exit_with_status "$EXIT_RESOLVER"

                }

            else

                validate_pool_for_mode local local-strict || {

                    log 1 "invalid local resolver pool"

                    exit_with_status "$EXIT_RESOLVER"

                }

            fi

            ;;
        remote)

            validate_pool_for_mode remote dns || {

                log 1 "invalid remote resolver pool"

                exit_with_status "$EXIT_RESOLVER"

            }
            ;;
    esac

    first_ep="$(pool_nth "$(pool_get "$ACTIVE_LOCATION")" 1)"

    [ -n "$first_ep" ] || {

        log 1 "no resolver endpoints available for active location"

        exit_with_status "$EXIT_RESOLVER"

    }

    RESOLVER="${first_ep%\#*}"

    if [ -n "$_FILE" ] && [ ! -r "$_FILE" ]; then

        log 1 "input file not readable: ${LIGHT_GREY}$_FILE"

        exit_with_status "$EXIT_USAGE"

    fi

    log_effective_config

    print_start_notice

    RAW="$TMPDIR/raw"
    DOMAINS="$TMPDIR/domains.txt"
    MAIN_DOMAINS="$TMPDIR/main_domains.txt"
    SRC_NAME="${_FILE:-$_URL}"

    fetch_source "$RAW" || {

        log 1 "failed to fetch source data"

        exit_with_status "$EXIT_NETWORK"

    }

    READ_SOURCE="${FETCH_SOURCE_PATH:-$RAW}"

    case "$SRC_NAME" in
        *.zip)

            need_cmd unzip || {

                log 1 "unzip required for zip sources"

                exit_with_status "$EXIT_DEPENDENCY"

            }

            ZIP_EXTRACT="$TMPDIR/unzipped.txt"

            validate_zip_file "$READ_SOURCE" || {

                log 1 "zip integrity check failed: ${LIGHT_GREY}$SRC_NAME"

                exit_with_status "$EXIT_PARSE"

            }

            extract_zip_to_file "$READ_SOURCE" "$ZIP_EXTRACT" || {

                log 1 "failed to extract zip source: ${LIGHT_GREY}$SRC_NAME"

                exit_with_status "$EXIT_PARSE"

            }

            extract_domains < "$ZIP_EXTRACT" > "$MAIN_DOMAINS"

            log 3 "extracted domains from zip source"

            ;;
        *)

            extract_domains < "$READ_SOURCE" > "$MAIN_DOMAINS"

            log 3 "extracted domains from source"

            ;;
    esac

    {

        if [ -r "$_CUSTOM" ]; then

            log 3 "using custom domain source: ${LIGHT_GREY}$_CUSTOM"

            extract_custom_domains < "$_CUSTOM"

        elif [ "$SEEN_C" -eq 1 ]; then

            log 3 "skipping custom domain source"

            log 3 "custom domain source not readable: ${LIGHT_GREY}$_CUSTOM"

        fi

    cat "$MAIN_DOMAINS"

    } | awk \
        -v filters="$_TOP_FILTERS" \
        -v top="$_TOP" \
        -v v="$_VERBOSITY" \
        -v GREY="$GREY" \
        -v NONE="$NONE" \
        -v LIGHT_GREY="$LIGHT_GREY" '

        function emit_domain(d) {
            out_count++

            if (dbg_trace) {
                printf "%s[%s…%s] %sdomain=%s%s %sposition=%s%d%s\n", \
                    LIGHT_GREY, GREY, LIGHT_GREY, GREY, LIGHT_GREY, d, GREY, LIGHT_GREY, \
                    out_count, NONE > "/dev/stderr"
            }

            print d

            if (out_count >= top) exit

        }

        BEGIN {
            nf = 0
            out_count = 0
            dbg_trace = ((v + 0) >= 5)

            if (filters != "") {
                n = split(filters, raw, " ")

                for (i = 1; i <= n; i++) {
                    pat = raw[i]

                    if (pat == "") continue

                    nf++
                    ftype[nf] = ""
                    fpat[nf]  = pat

                    if (pat ~ /^\/.*\/$/) {
                        ftype[nf] = "regex"
                        fpat[nf]  = substr(pat, 2, length(pat) - 2)
                    } else if (substr(pat, 1, 2) == "||") {
                        ftype[nf] = "anchor"
                        fpat[nf]  = substr(pat, 3)
                        gsub(/\./, "\\.", fpat[nf])
                        fpat[nf] = "(^|\\.)" fpat[nf] "$"
                    } else if (substr(pat, 1, 1) == "^") {
                        ftype[nf] = "prefix"
                        fpat[nf]  = substr(pat, 2)
                    } else if (substr(pat, 1, 1) == ".") {
                        ftype[nf] = "suffix"
                        fpat[nf]  = pat
                    } else {
                        ftype[nf] = "substr"
                    }

                }

            }

        }

        {
            d = $0

            if (d == "") next

            if (seen[d]++) next

            if (nf == 0) {
                emit_domain(d)
                next
            }

            dlen = length(d)
            matched = 0

            for (i = 1; i <= nf; i++) {

                if (ftype[i] == "suffix") {
                    fl   = fpat[i]
                    flen = length(fl)

                    if (dlen >= flen && substr(d, dlen - flen + 1) == fl) {
                        matched = 1
                        break
                    }

                } else if (ftype[i] == "prefix") {

                    if (index(d, fpat[i]) == 1) {
                        matched = 1
                        break
                    }

                } else if (ftype[i] == "regex" || ftype[i] == "anchor") {

                    if (d ~ fpat[i]) {
                        matched = 1
                        break
                    }

                } else {

                    if (index(d, fpat[i]) > 0) {
                        matched = 1
                        break
                    }

                }

            }

            if (matched) emit_domain(d)

        }
    ' > "$DOMAINS"

    _DOMAINS="$(wc -l < "$DOMAINS" | tr -d ' ')"

    [ "$_DOMAINS" -gt 0 ] || {

        log 1 "no domains found in source after filtering"

        exit_with_status "$EXIT_PARSE"

    }

    if [ "$_MAX_DOMAINS_LINES" -gt 0 ] && [ "$_DOMAINS" -gt "$_MAX_DOMAINS_LINES" ]; then

        log 1 "domain count exceeds ceiling (${LIGHT_GREY}$_DOMAINS${RED} > ${LIGHT_GREY}$_MAX_DOMAINS_LINES${RED})"

        exit_with_status "$EXIT_RUNTIME"

    fi

    log 3 "got ${LIGHT_GREY}$_DOMAINS ${BLUE}domains from source"

    if [ "$_RESOLVER_STRATEGY" = "fastest" ]; then

        log 3 "resolver strategy ${LIGHT_GREY}fastest${BLUE}: probing endpoints"

        select_fastest_resolver "$ACTIVE_LOCATION" "$DOMAINS" || {

            log 1 "failed to select fastest resolver endpoint"

            exit_with_status "$EXIT_RESOLVER"

        }

    fi

    auto_tune_worker_and_burst

    compute_dispatch_profile "$ACTIVE_LOCATION" || {

        log 1 "failed to compute dispatch profile"

        exit_with_status "$EXIT_INTERNAL"

    }

    init_dispatch_single_endpoint "$ACTIVE_LOCATION"

    DIG_BATCHES_ENQUEUED=0
    DIG_BATCH_SEQ=0
    DIG_BATCH_DIR=""

    if [ "$_BINARY" = "dig" ] && [ "$_DIG_BATCH" -eq 1 ] && [ "$_DIG_BATCH_SIZE_EFFECTIVE" -gt 1 ]; then
        DIG_BATCH_DIR="$TMPDIR/dig-batches"

        mkdir -p "$DIG_BATCH_DIR" || {

            log 0 "failed to create dig batch directory: ${LIGHT_GREY}$DIG_BATCH_DIR"

            exit_with_status "$EXIT_QUEUE"

        }

        log 3 "dig batching enabled: ${LIGHT_GREY}size=$_DIG_BATCH_SIZE_EFFECTIVE${BLUE} (logical=${LIGHT_GREY}$DIG_BATCH_LOGICAL_SIZE_EFFECTIVE${BLUE})"

    fi

    MBUCKET=$((_BURST * 1000))
    MTOKENS="$MBUCKET"
    START_TS="$(now_ms)"
    START_MONO="$(mono_ms)"
    LAST_MONO="$START_MONO"
    LAST_SENT_MS="$START_TS"
    DEBUG_TICK_MS="$START_MONO"

    open_domains || {

        log 0 "failed to open domain list: ${LIGHT_GREY}$DOMAINS"

        exit_with_status "$EXIT_RUNTIME"

    }

    init_sleep_capability

    start_worker_pool "$_MAXIMUM" || exit_with_status "$EXIT_QUEUE"

    log 3 "worker pool size: ${LIGHT_GREY}$_MAXIMUM"

    QUERIES_START=0

    if [ "$_RANDOM" -eq 1 ]; then

        init_random_rr_pool

        init_query_type_tracking

        log 3 "random RR mode enabled with pool: ${LIGHT_GREY}$RANDOM_RR_POOL"

    fi

    DURATION_MS=$((_DURATION * 1000))
    CLOCK_TICK_MS="$_CLOCK_TICK_MS"

    [ "$CLOCK_TICK_MS" -lt 1 ] && CLOCK_TICK_MS=1

    DISPATCH_TOKEN_COST_UNITS=$((DISPATCH_TOKEN_COST * 1000))

    [ "$DISPATCH_TOKEN_COST_UNITS" -ge 1000 ] || DISPATCH_TOKEN_COST_UNITS=1000

    STOP_MAIN=0
    STOP_REASON="normal"

    while :; do

        if [ "$_DURATION" -eq 0 ]; then

            [ -s "$DOMAINS" ] || {

                log 0 "${RED}domains file is empty: ${LIGHT_GREY}$DOMAINS"

                STOP_MAIN=1
                STOP_REASON="domains-empty"
                break
            }

        fi

        now_m="$(mono_ms)"
        elapsed_ms=$((now_m - START_MONO))

        if [ "$_DURATION" -gt 0 ] && [ "$elapsed_ms" -ge "$DURATION_MS" ]; then
            STOP_REASON="duration"

            log 5 "elapsed=${LIGHT_GREY}${elapsed_ms}ms ${GREY}>= ${LIGHT_GREY}${DURATION_MS}ms"

            break
        fi

        dt_ms=$((now_m - LAST_MONO))

        if [ "$dt_ms" -gt 0 ]; then
            MTOKENS=$((MTOKENS + (_QPS * dt_ms)))

            [ "$MTOKENS" -gt "$MBUCKET" ] && MTOKENS="$MBUCKET"

            LAST_MONO="$now_m"
        fi

        if [ $((now_m - DEBUG_TICK_MS)) -ge 1000 ]; then

            log 5 "elapsed=${LIGHT_GREY}${elapsed_ms}ms ${GREY}sent=${LIGHT_GREY}$SENT ${GREY}mtokens=${LIGHT_GREY}$MTOKENS"

            DEBUG_TICK_MS="$now_m"
        fi

        if [ "$MTOKENS" -lt "$DISPATCH_TOKEN_COST_UNITS" ]; then
            deficit=$((DISPATCH_TOKEN_COST_UNITS - MTOKENS))

            [ "$deficit" -lt 1 ] && deficit=1

            wait_ms=$(((deficit + _QPS - 1) / _QPS))

            [ "$wait_ms" -lt 1 ] && wait_ms=1

            [ "$wait_ms" -gt "$CLOCK_TICK_MS" ] && wait_ms="$CLOCK_TICK_MS"

            nap_for_tokens "$wait_ms"

            continue
        fi

        send_budget=$((MTOKENS / DISPATCH_TOKEN_COST_UNITS))

        [ "$send_budget" -gt "$DISPATCH_BURST_LOGICAL" ] && send_budget="$DISPATCH_BURST_LOGICAL"

        if [ "$send_budget" -gt 1 ]; then
            BURST_TRIGGERED=$((BURST_TRIGGERED + 1))
        fi

        i=0

        while [ "$i" -lt "$send_budget" ]; do

            if [ -n "$DIG_BATCH_DIR" ]; then

                if [ -n "$DISPATCH_SINGLE_ENDPOINT" ]; then

                    if test_fault_should_fire && [ "$DNDISTRESS_TEST_FAULT_STOP_REASON" = "resolver-pick-fail" ]; then
                        targets=""
                    else
                        targets="$DISPATCH_SINGLE_ENDPOINT"
                    fi

                else
                    targets="$(resolver_targets_for_dispatch "$ACTIVE_LOCATION" 2>/dev/null || true)"
                fi

                if [ -z "$targets" ]; then

                    log 0 "failed to pick resolver endpoint(s)"

                    STOP_MAIN=1
                    STOP_REASON="resolver-pick-fail"
                    break
                fi

                DIG_BATCH_SEQ=$((DIG_BATCH_SEQ + 1))
                batch_map="$DIG_BATCH_DIR/batch.$DIG_BATCH_SEQ.map"

                : > "$batch_map" || {
                    log 0 "failed to create dig batch map: ${LIGHT_GREY}$batch_map"
                    STOP_MAIN=1
                    STOP_REASON="batch-create-fail"
                    break
                }

                oldifs=$IFS
                IFS='
'
                batch_target_count=0
                for ep in $targets; do
                    [ -n "$ep" ] || continue

                    batch_host="${ep%\#*}"
                    batch_port="${ep##*\#}"
                    batch_target_count=$((batch_target_count + 1))
                    batch_file="$DIG_BATCH_DIR/batch.$DIG_BATCH_SEQ.$batch_target_count.txt"

                    : > "$batch_file" || {
                        log 0 "failed to create dig batch file: ${LIGHT_GREY}$batch_file"
                        STOP_MAIN=1
                        STOP_REASON="batch-create-fail"
                        break
                    }

                    printf '%s|%s|%s\n' "$batch_host" "$batch_port" "$batch_file" >> "$batch_map" || {
                        log 0 "failed to write dig batch map: ${LIGHT_GREY}$batch_map"
                        STOP_MAIN=1
                        STOP_REASON="batch-write-fail"
                        break
                    }
                done
                IFS=$oldifs

                [ "$STOP_MAIN" -eq 1 ] && break

                batch_count=0

                while [ "$i" -lt "$send_budget" ] && [ "$batch_count" -lt "$DIG_BATCH_LOGICAL_SIZE_EFFECTIVE" ]; do

                    if ! next_domain; then

                        if [ "$_DURATION" -eq 0 ]; then
                            break
                        fi

                        STOP_MAIN=1
                        STOP_REASON="eof"
                        break
                    fi

                    d="$CUR"

                    [ -n "$d" ] || {
                        i=$((i + 1))
                        continue
                    }

                    pick_query_type

                    qtype="$PICKED_QTYPE"

                    if [ "$QUERIES_START" -eq 0 ]; then
                        QUERIES_START=$((START_TS + now_m - START_MONO))
                    fi

                    while IFS='|' read -r batch_host batch_port batch_file; do
                        [ -n "$batch_file" ] || continue

                        printf '%s %s\n' "$d" "$qtype" >> "$batch_file" || {

                            log 0 "failed to write dig batch file: ${LIGHT_GREY}$batch_file"

                            STOP_MAIN=1
                            STOP_REASON="batch-write-fail"
                            break
                        }
                    done < "$batch_map"

                    [ "$STOP_MAIN" -eq 1 ] && break

                    LOGICAL_SENT=$((LOGICAL_SENT + 1))
                    SENT=$((SENT + DISPATCH_TOKEN_COST))

                    bump_query_type_count "$qtype"

                    LAST_SENT_MS=$((START_TS + now_m - START_MONO))
                    MTOKENS=$((MTOKENS - DISPATCH_TOKEN_COST_UNITS))
                    i=$((i + 1))
                    batch_count=$((batch_count + 1))
                done

                if [ "$batch_count" -gt 0 ]; then

                    while IFS='|' read -r batch_host batch_port batch_file; do

                        [ -n "$batch_file" ] || continue

                        if ! enqueue_job "${DIG_BATCH_PREFIX}|$batch_count|$batch_file|$batch_host|$batch_port"; then
                            log 0 "worker queue write failed for dig batch: ${LIGHT_GREY}$batch_file"
                            STOP_MAIN=1
                            STOP_REASON="queue-fail"
                            break
                        fi

                    done < "$batch_map"

                    [ "$STOP_MAIN" -eq 1 ] && {

                        rm -f "$batch_map" 2>/dev/null || true

                        break
                    }

                    DIG_BATCHES_ENQUEUED=$((DIG_BATCHES_ENQUEUED + batch_target_count))
                else

                    while IFS='|' read -r batch_host batch_port batch_file; do

                        [ -n "$batch_file" ] && rm -f "$batch_file" 2>/dev/null || true

                    done < "$batch_map"

                    rm -f "$batch_map" 2>/dev/null || true

                    break
                fi

                rm -f "$batch_map" 2>/dev/null || true

                [ "$STOP_MAIN" -eq 1 ] && break

                continue
            fi

            if ! next_domain; then

                if [ "$_DURATION" -eq 0 ]; then
                    break
                fi

                STOP_MAIN=1
                STOP_REASON="eof"
                break
            fi

            d="$CUR"

            [ -n "$d" ] || {
                i=$((i + 1))
                continue
            }

            pick_query_type

            qtype="$PICKED_QTYPE"

            if [ "$QUERIES_START" -eq 0 ]; then
                QUERIES_START=$((START_TS + now_m - START_MONO))
            fi

            if [ -n "$DISPATCH_SINGLE_ENDPOINT" ]; then

                if test_fault_should_fire && [ "$DNDISTRESS_TEST_FAULT_STOP_REASON" = \
                    "resolver-pick-fail" ]; then
                    targets=""
                else
                    targets="$DISPATCH_SINGLE_ENDPOINT"
                fi

            else
                targets="$(resolver_targets_for_dispatch \
                    "$ACTIVE_LOCATION" 2>/dev/null || true)"
            fi

            if [ -z "$targets" ]; then
                STOP_MAIN=1
                STOP_REASON="resolver-pick-fail"
                break
            fi

            enqueue_failed=0
            oldifs=$IFS
            IFS='
'
            for ep in $targets; do

                [ -n "$ep" ] || continue

                host="${ep%\#*}"
                port="${ep##*\#}"

                if ! enqueue_job "${qtype}|$d|$host|$port"; then
                    enqueue_failed=1
                    break
                fi

            done

            IFS=$oldifs

            if [ "$enqueue_failed" -eq 1 ]; then

                log 0 "worker queue write failed for domain: ${LIGHT_GREY}$d"

                STOP_MAIN=1
                STOP_REASON="queue-fail"
                break
            fi

            LOGICAL_SENT=$((LOGICAL_SENT + 1))
            SENT=$((SENT + DISPATCH_TOKEN_COST))

            bump_query_type_count "$qtype"

            LAST_SENT_MS=$((START_TS + now_m - START_MONO))
            MTOKENS=$((MTOKENS - DISPATCH_TOKEN_COST_UNITS))
            i=$((i + 1))
        done

        [ "$STOP_MAIN" -eq 1 ] && break

    done

    if [ "$DOMAINS_EOF" -eq 1 ]; then

        log 3 "domain list exhausted: ${LIGHT_GREY}$DOMAINS"

        log 5 "ending query loop"

    fi

    exec 3<&-

    if [ "$STOP_REASON" = "duration" ] && [ "$_DRAIN_TIMEOUT_MS" -gt 0 ]; then

        log 2 "duration reached"

        log 3 "draining worker queue (max ${LIGHT_GREY}${_DRAIN_TIMEOUT_MS}ms${BLUE})"

        stop_worker_pool graceful "$_DRAIN_TIMEOUT_MS"

    else

        stop_worker_pool

    fi

    merge_answer_shards

    sum_completed_shards

    finalise_worker_metrics

    END_MS="$(now_ms)"

    if [ "$_VERBOSITY" -gt 0 ]; then

        show_runtime_report

    fi

    if [ "${DRAIN_FORCED:-0}" -eq 1 ]; then
        return "$EXIT_TIMEOUT"
    fi

    case "${STOP_REASON:-normal}" in
        normal|duration|eof)
            return "$EXIT_OK"
            ;;
        queue-fail|batch-create-fail|batch-write-fail)
            return "$EXIT_QUEUE"
            ;;
        resolver-pick-fail)
            return "$EXIT_RESOLVER"
            ;;
        domains-empty)
            return "$EXIT_PARSE"
            ;;
        *)

            log 0 "internal stop-reason state error: ${LIGHT_GREY}${STOP_REASON:-unknown}"

            return "$EXIT_INTERNAL"
            ;;
    esac

}

if [ "${DNDISTRESS_TEST_MODE:-0}" != "1" ]; then

    if do_DNdistresS "$@"; then
        rc="$EXIT_OK"
    else
        rc=$?
    fi

    exit_with_status "$rc"

fi
