            _LOCAL_POOL="${_LOCAL_POOL}${_LOCAL_POOL:+
}$_entry"
            ;;
        remote)
            printf '%s\n' "$_REMOTE_POOL" | grep -Fx -- "$_entry" >/dev/null 2>&1 && return 0
            _REMOTE_POOL="${_REMOTE_POOL}${_REMOTE_POOL:+
}$_entry"
            ;;
        *)
            return 1
            ;;
    esac

    return 0
