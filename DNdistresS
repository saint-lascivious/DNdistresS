    COMPLETED_QPS_WINDOW=0
    COMPLETED_QPS_TOTAL=0

    if [ -f "$ANSWERS_FILE" ]; then
        IFS=' ' read -r BLOCKED NXDOMAIN TOTAL <<EOF
$(awk '
    BEGIN { b=0; n=0; t=0 }
    {
        t++
        if ($0=="0.0.0.0" || $0=="::") b++
        if ($0=="NXDOMAIN") n++
    }
    END { printf "%d %d %d\n", b, n, t }
' "$ANSWERS_FILE")
EOF

        BLOCKED="${BLOCKED:-0}"
        NXDOMAIN="${NXDOMAIN:-0}"
        TOTAL="${TOTAL:-0}"
        ANSWERED="$TOTAL"

        if [ "$TOTAL" -gt 0 ]; then
            BLOCK_PCT=$(awk -v b="$BLOCKED" -v t="$TOTAL" 'BEGIN{printf "%.0f", (b/t)*100}')
            NXDOMAIN_PCT=$(awk -v n="$NXDOMAIN" -v t="$TOTAL" 'BEGIN{printf "%.0f", (n/t)*100}')
        fi

