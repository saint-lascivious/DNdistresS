            brace_depth=0
            max_brace_depth=0

            in_heredoc=0
            heredoc_end=""

            in_sq=0
            in_dq=0

            sq=sprintf("%c",39)

            blank=0; nonblank=0; sloc=0
            comments=0; directives=0
            ifs=0; case_count=0; arms=0; loop_count=0
            pipes=0; subshells=0; heredocs=0; sourcing=0; traps=0; exits=0
            char_total=0; char_nonws=0; max_line_len=0
        }

        function trim(s) {
            sub(/^[[:space:]]+/, "", s)
            sub(/[[:space:]]+$/, "", s)
            return s
        }

        function strip_shell_literals(s,   i,c,out) {
            out=""

            for (i=1; i<=length(s); i++) {
                c=substr(s,i,1)

                if (in_sq) {

                    if (c == sq) in_sq=0

                    continue
                }

                if (in_dq) {

                    if (c == "\\") { i++; continue }

                    if (c == "\"") in_dq=0

                    continue
                }

                if (c == sq) { in_sq=1; continue }

                if (c == "\"") { in_dq=1; continue }

                if (c == "#") break

                out = out c
            }

            return out
        }

        function brace_delta(s,   t,o,c) {
            t=s; o=gsub(/\{/, "{", t)
            t=s; c=gsub(/\}/, "}", t)
            return (o-c)
        }

        function fn_name_from_line(s, t) {
            t=s
            sub(/^[[:space:]]*/, "", t)
            sub(/^function[[:space:]]+/, "", t)
            sub(/[[:space:]]*\(\)[[:space:]]*\{[[:space:]]*$/, "", t)
            sub(/[[:space:]]*\{[[:space:]]*$/, "", t)
            return t
        }

        function is_shell_keyword(n) {
            return (n=="if" || n=="then" || n=="elif" || n=="else" || \
                    n=="fi" || n=="for" || n=="while" || n=="until" || \
                    n=="do" || n=="done" || n=="case" || n=="esac" || \
                    n=="in" || n=="select" || n=="function" || n=="time")
        }

        function fmt_pct(x, s) {
            s = sprintf("%.2f", x + 0)

            if (s == "0.00") return "0"

            return s
        }

        function push_fn(name) {

            if (name == "" || is_shell_keyword(name)) return

            fn_sp++
            fn_name[fn_sp]=name
            fn_len[fn_sp]=1
            fn_count++

            if (fn_sp > max_fn_nesting) max_fn_nesting=fn_sp

        }

        function bump_active_fn_loc(i) {

            for (i=1; i<=fn_sp; i++) fn_len[i]++

        }

        function pop_fn(   l,n) {

            if (fn_sp <= 0) return

            l=fn_len[fn_sp]
            n=fn_name[fn_sp]

            fn_total += l

            if (l > fn_max) {
                fn_max=l
                max_fn_name=n
            }

            if (l >= 50) fn_50++

            if (l >= 100) fn_100++

            if (l >= 1000) fn_1000++

            delete fn_name[fn_sp]
            delete fn_len[fn_sp]
            fn_sp--
        }

        function detect_heredoc_start(clean,   tok) {

            if (in_heredoc) return

            if (match(clean, /<<-?[[:space:]]*[A-Za-z_][A-Za-z0-9_]*/)) {
                tok=substr(clean, RSTART, RLENGTH)
                sub(/^<<-?[[:space:]]*/, "", tok)

                if (tok != "") {
                    in_heredoc=1
                    heredoc_end=tok
                }

            }

        }

        {
            line=$0
            tline=trim(line)

            char_total += length(line)
            tmp_nonws=line
            gsub(/[[:space:]]/, "", tmp_nonws)
            char_nonws += length(tmp_nonws)

            if (length(line) > max_line_len) max_line_len=length(line)

            if (line ~ /^[[:space:]]*$/) blank++

            else nonblank++

            is_shebang = (NR == 1 && line ~ /^#!/)

            is_directive = 0

            if (!is_shebang && line ~ /^[[:space:]]*#[[:space:]]*shellcheck([[:space:]]|$)/) {
                is_directive = 1
            }

            is_comment = (!is_shebang && !is_directive && line ~ /^[[:space:]]*#/)

            if (is_directive) directives++

            if (is_comment) comments++

            if (!is_shebang && !is_directive && !is_comment && tline != "") sloc++

            tmp=line

            while (match(tmp, /(^|[[:space:];(])(export[[:space:]]+|readonly[[:space:]]+|local[[:space:]]+|typeset[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=/)) {
                seg=substr(tmp, RSTART, RLENGTH)
                sub(/.*[[:space:];(]/, "", seg)
                sub(/^(export|readonly|local|typeset)[[:space:]]+/, "", seg)
                sub(/=.*/, "", seg)

                if (seg ~ /^[A-Za-z_][A-Za-z0-9_]*$/) seen[seg]=1

                tmp=substr(tmp, RSTART+RLENGTH)
            }

            tmp=line

            while (match(tmp, /\$\{[A-Za-z_][A-Za-z0-9_]*/)) {
                v=substr(tmp, RSTART+2, RLENGTH-2)
                seen[v]=1
                tmp=substr(tmp, RSTART+RLENGTH)
            }

            tmp=line

            while (match(tmp, /\$[A-Za-z_][A-Za-z0-9_]*/)) {
                v=substr(tmp, RSTART+1, RLENGTH-1)
                seen[v]=1
                tmp=substr(tmp, RSTART+RLENGTH)
            }

            bump_active_fn_loc()

            if (in_heredoc) {

                if (tline == heredoc_end) {
                    in_heredoc=0
                    heredoc_end=""
                }

                next

            }

            clean = strip_shell_literals(line)

            brace_depth += brace_delta(clean)

            if (brace_depth > max_brace_depth) max_brace_depth=brace_depth

            if (brace_depth < 0) brace_depth=0

            is_fn_decl = (clean ~ /^[[:space:]]*(function[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*([[:space:]]*\(\))?[[:space:]]*\{[[:space:]]*$/)
            is_close_only = (clean ~ /^[[:space:]]*\}[[:space:]]*$/)

            if (is_fn_decl) push_fn(fn_name_from_line(clean))

            if (is_close_only) pop_fn()

            detect_heredoc_start(clean)

            if (!is_comment && !is_directive) {

                if (line ~ /^[[:space:]]*if[[:space:]]/ || line ~ /^[[:space:]]*elif[[:space:]]/ || line ~ /^[[:space:]]*else[[:space:]]*$/) ifs++

                if (line ~ /^[[:space:]]*case[[:space:]].*[[:space:]]*in[[:space:]]*$/) case_count++

                tmp=line

                while (match(tmp, /;;/)) { arms++; tmp=substr(tmp, RSTART+RLENGTH) }

                if (line ~ /^[[:space:]]*(for|while|until|select)[[:space:]]/) loop_count++

                tmp=line

                while (match(tmp, /\|[^|]/)) { pipes++; tmp=substr(tmp, RSTART+RLENGTH) }

                tmp=line

                while (match(tmp, /\$\(/)) { subshells++; tmp=substr(tmp, RSTART+RLENGTH) }

                tmp=line

                while (match(tmp, /<<[-]?[[:space:]]*/)) { heredocs++; tmp=substr(tmp, RSTART+RLENGTH) }

                if (line ~ /^[[:space:]]*(\.|source)[[:space:]]+[A-Za-z0-9_\.\/-]+/) sourcing++

                if (line ~ /(^|[[:space:];])exit([[:space:];]|$)/) exits++

                if (line ~ /^[[:space:]]*trap[[:space:]]/) traps++

            }

        }

        END {

            while (fn_sp > 0) pop_fn()

            vars=0

            for (k in seen) vars++

            total = nonblank + blank
            avg_fn = (fn_count > 0 ? fn_total / fn_count : 0)
            c_pct = (nonblank > 0 ? (comments * 100.0) / nonblank : 0)
            c_pct_disp = fmt_pct(c_pct)
            avg_arms = (case_count > 0 ? arms / case_count : 0)
            nonblank_pct = (total > 0 ? (nonblank * 100.0) / total : 0)
            sloc_pct = (total > 0 ? (sloc * 100.0) / total : 0)
            blank_pct = (total > 0 ? (blank * 100.0) / total : 0)
            nonblank_pct_disp = fmt_pct(nonblank_pct)
            sloc_pct_disp = fmt_pct(sloc_pct)
            blank_pct_disp = fmt_pct(blank_pct)
            avg_nonws_per_sloc = (sloc > 0 ? char_nonws / sloc : 0)
            nonblank_x = (nonblank > 0 ? sprintf("%.2fx", total / nonblank) : "n/a")
            sloc_x = (sloc > 0 ? sprintf("%.2fx", total / sloc) : "n/a")
            blank_x = (blank > 0 ? sprintf("%.2fx", total / blank) : "n/a")
            comment_x = (comments > 0 ? sprintf("%.2fx", nonblank / comments) : "n/a")

            printf "\
Functions:             %d\n\
Max function LOC:      %d\n\
  (%s())\n\
\n\
Average function LOC:  %.2f\n\
Functions >=50 LOC:    %d\n\
Functions >=100 LOC:   %d\n\
Functions >=1000 LOC:  %d\n\
Function nesting:      %d\n\
  (maximum depth)\n\
\n\
Maximum depth:         %d\n\
  (maximum brace nesting depth)\n\
\n\
Total:                 %d (all lines)\n\
Non-blank:             %d\n\
SLOC:                  %d\n\
  (excludes blank/comment/shebang/directive)\n\
\n\
Non-blank ratio:       %s%%\n\
                       %d/%d non-blank/total\n\
                       %s total/non-blank\n\
SLOC ratio:            %s%%\n\
                       %d/%d sloc/total\n\
                       %s total/sloc\n\
Blank ratio:           %s%%\n\
                       %d/%d blank/total\n\
                       %s total/blank\n\
Blank:                 %d\n\
Characters:            %d\n\
Non-whitespace chars:  %d\n\
Avg chars/SLOC:        %.2f\n\
  (non-whitespace)\n\
\n\
Longest line:          %d\n\
\n\
Comments:              %d\n\
  (excludes shebang)\n\
\n\
Shellcheck directives: %d\n\
Comment ratio:         %s%%\n\
                       %d/%d comments/non-blank\n\
                       %s non-blank/comments\n\
\n\
Variables:             %d\n\
  (unique shell-style variables seen)\n\
\n\
If/Elif/Else blocks:   %d\n\
