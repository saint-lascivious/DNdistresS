latency_stats_file() {
    f="$1"
    trim_pct="${2:-10}"
    pct="${3:-95}"
    mode="${4:-percent}"

    [ -r "$f" ] || return 1

    sort -n "$f" 2>/dev/null | awk -v trim="$trim_pct" -v p="$pct" -v mode="$mode" '
        $1 ~ /^[0-9]+$/ { a[++n] = $1 }
        END {

            if (n < 1) exit 1

            lo=1; hi=n

            if (mode == "edges1") {
                if (n >= 3) { lo=2; hi=n-1 }
            } else {
                if (trim < 0) trim=0
                if (trim > 40) trim=40
                lo = int(n * trim / 100) + 1
                hi = n - int(n * trim / 100)
                if (hi < lo) { lo=1; hi=n }
            }

            m=0; s=0

            for (i=lo; i<=hi; i++) { b[++m]=a[i]; s+=a[i] }

            if (m < 1) exit 1

            mean = s / m

            mid = int((m + 1) / 2)

            if (m % 2) p50 = b[mid]

            else p50 = (b[mid] + b[mid + 1]) / 2

            if (p < 1) p=1

            if (p > 99) p=99

            idx = int((m * p + 99) / 100)

            if (idx < 1) idx=1

            if (idx > m) idx=m

            pp = b[idx]

            printf "%.2f %.0f %.0f %d\n", mean, p50, pp, m
        }
    '

}

select_fastest_resolver() {
    _mode="$1"
    _domains_file="$2"

    _pool="$(pool_get "$_mode")"
    _count="$(pool_count "$_pool")"

    [ "$_count" -gt 0 ] || return 1

    [ "$_count" -gt 1 ] || {
        _only_ep="$(pool_nth "$_pool" 1)"
        RESOLVER="${_only_ep%\#*}"
        _PORT="${_only_ep##*\#}"
        FASTEST_SELECTED_ENDPOINT="$_only_ep"
        FASTEST_SELECTED_MS="0"
        FASTEST_SELECTED_DOMAIN="(single-endpoint)"
        FASTEST_SELECTED_TYPE="$_TYPE"
        return 0
    }

    probes="${_FASTEST_PROBE_COUNT:-5}"

    is_posint "$probes" || probes=5

    [ "$probes" -ge 1 ] || probes=1

    case "${_FASTEST_PROBE_DOMAIN:-random}" in
        random)
            probe_domain="$(sample_domains_from_file "$_domains_file" 1 random 2>/dev/null | awk 'NF{print; exit}' || true)"
            ;;
        first|head)
            probe_domain="$(sample_domains_from_file "$_domains_file" 1 first 2>/dev/null | awk 'NF{print; exit}' || true)"
            ;;
        *)
            probe_domain="${_FASTEST_PROBE_DOMAIN}"
            ;;
    esac

    [ -n "$probe_domain" ] || {

        log 1 "fastest strategy failed: no probe domain available"

        return 1
    }

    probe_type="$(resolve_probe_qtype)"

    bench_root="${TMPDIR:-/tmp}"

    [ -n "$bench_root" ] || bench_root="/tmp"

    bench_dir="$bench_root/fastest-bench.$$.$(now_ms)"

    mkdir -p "$bench_dir" || return 1

    old_output="$_OUTPUT"
    _OUTPUT="quiet"

    best_ep=""
    best_ms=""
    idx=0

    oldifs=$IFS
    IFS='
'
    for ep in $_pool; do

        [ -n "$ep" ] || continue

        idx=$((idx + 1))

        host="${ep%\#*}"
        port="${ep##*\#}"

        sample_file="$bench_dir/samples.$idx.txt"
        : > "$sample_file"

        i=1

        while [ "$i" -le "$probes" ]; do
            d_ms="$(probe_query_latency_ms "$probe_domain" "$probe_type" \
                "$bench_dir/answers.$idx.txt" "$host" "$port" 2>/dev/null || printf '1\n')"
            printf '%s\n' "$d_ms" >> "$sample_file"
            i=$((i + 1))
        done

        stats_line="$(latency_stats_file "$sample_file" 0 50 edges1 2>/dev/null || true)"
        mean_ms="$(printf '%s\n' "$stats_line" | awk 'NF{print $1; exit}')"

        case "$mean_ms" in
            ''|*[!0-9.]*)
                continue
                ;;
        esac

        if [ -z "$best_ep" ]; then
            best_ep="$ep"
            best_ms="$mean_ms"
        else

            if awk -v a="$mean_ms" -v b="$best_ms" 'BEGIN{ exit ((a < b) ? 0 : 1) }'; then
                best_ep="$ep"
                best_ms="$mean_ms"
            fi

        fi

        log 4 "fastest probe ${LIGHT_GREY}${host}#${port}${GREY}: mean=${LIGHT_GREY}${mean_ms}ms"

    done

    IFS=$oldifs

    _OUTPUT="$old_output"

    [ -n "$best_ep" ] || return 1

    case "$_mode" in
        local)
            _LOCAL_POOL="$best_ep"
            _LOCAL="${best_ep%\#*}"
            ;;
        remote)
            _REMOTE_POOL="$best_ep"
            _REMOTE="${best_ep%\#*}"
            ;;
    esac

    RESOLVER="${best_ep%\#*}"
    _PORT="${best_ep##*\#}"

    FASTEST_SELECTED_ENDPOINT="$best_ep"
    FASTEST_SELECTED_MS="$best_ms"
    FASTEST_SELECTED_DOMAIN="$probe_domain"
    FASTEST_SELECTED_TYPE="$probe_type"

    log 3 "fastest resolver selected: ${LIGHT_GREY}${RESOLVER}#${_PORT}${BLUE} (${LIGHT_GREY}${best_ms}ms${BLUE} trimmed mean)"

    return 0
}

