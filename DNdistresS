usage() {

    prog_name="${0##*/}"

    awk -v prog="$prog_name" -v syn="$SYNOPSIS" -v cols="${COLUMNS:-80}" '
        BEGIN {
            print "Usage:"
            head = "  " prog " "
            ind  = sprintf("%" length(head) "s", "")
            line = head
            s    = syn

            while (length(s) > 0) {

                if (substr(s,1,1) != "[") break

                depth = 0
                tok = ""

                for (i = 1; i <= length(s); i++) {
                    c = substr(s, i, 1)
                    tok = tok c

                    if (c == "[") depth++

                    else if (c == "]") { depth--; if (depth == 0) break }
                }

                s = substr(s, length(tok) + 1)
                sub(/^[[:space:]]+/, "", s)
                cand = (line == head) ? line tok : line " " tok

                if (length(cand) + 2 > cols) {
                    printf "%s \\\n", line
                    line = ind tok
                } else {
                    line = cand
                }

            }

            print line
            print ""
            print "  " prog " --help [topic]"
            print "  " prog " help [topic]"
            print "  " prog " install [PATH]"
            print "  " prog " uninstall [PATH]"
            print "  " prog " show {w|c|warranty|conditions}"
            print "  " prog " --show {w|c|warranty|conditions}"
            print "  " prog " --show-warranty"
            print "  " prog " --show-conditions"
        }
    '

    cat <<EOF

Help:
  -h, --help [topic]

  help [topic]
    Show help for a specific topic. Topic can be a command or option.

    Reverse parsing is supported (examples):
      ${0##*/} --help --install
      ${0##*/} --install --help
      ${0##*/} --help -q
      ${0##*/} -q --help

Topic examples:
  install, uninstall, show, version, verbosity

Tip:
  Run '${0##*/} --help topics' to list all available topics.
  For scripting/completion, use '${0##*/} --help topics-list'.
EOF

}

parse_top_opt() {
    _t_count=""
    _t_filters=""

    for _t_arg in "$@"; do

        case "$_t_arg" in
            /*/)
                _t_filters="${_t_filters:+$_t_filters }$_t_arg"
                ;;
            '||'*)
                _t_filters="${_t_filters:+$_t_filters }$_t_arg"
                ;;
            ^*)
                _t_filters="${_t_filters:+$_t_filters }$_t_arg"
                ;;
            .*)
                _t_filters="${_t_filters:+$_t_filters }$_t_arg"
                ;;
            *[!0-9]*)
                _t_filters="${_t_filters:+$_t_filters }$_t_arg"
                ;;
            ''|0)

                log 1 "invalid count value for ${LIGHT_GREY}-t${RED}/${LIGHT_GREY}--top${RED}: ${LIGHT_GREY}$_t_arg"

                return 1
                ;;
            *)

                [ -z "$_t_count" ] || {

                    log 1 "multiple count values supplied to ${LIGHT_GREY}-t${RED}/${LIGHT_GREY}--top${RED}: ${LIGHT_GREY}$_t_count and $_t_arg"

                    return 1
                }

                _t_count="$_t_arg"
                ;;
        esac

    done

    [ -n "$_t_count" ] || {

        log 1 "${LIGHT_GREY}-t${RED}/${LIGHT_GREY}--top ${RED}requires a positive integer count argument"

        return 1
    }

    printf '%s\n' "$_t_count"
    printf '%s\n' "$_t_filters"
    return 0
}

help_topic_what_body() {

    cat <<EOF
DNdistresS is a controlled DNS workload generator.

It repeatedly queries domains with configurable rate, burst, concurrency
runtime, resolver target, query type, source lists, and caching behaviour.

It makes DNS traffic on purpose, in ways you can shape.

It can make a lot of it, a little bit of it, or a very specific amount of it.
EOF

}

help_topic_why_body() {

    cat <<EOF
DNdistresS exists to answer a question that no one asked:

"What if I wanted to poke and prod my DNS servers any which way I wanted, but
for some reason all I have is a POSIX shell, a handful of built-ins, and a few
common utilities?"

Use it for cache priming, baseline and stress comparison, change validation
reproducible resolver/network tests, interrogation, and automation whenever a
repeatable DNS workload is desired.

DNdistresS generates predictable domain name server pressure, helping to find
limitations before they find you, and to validate that changes have the
intended effect.
EOF

}

