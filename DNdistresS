RANDOM_RR_POOL="${_RANDOM_RR_POOL:-A AAAA CNAME MX NS TXT}"

RANDOM_POOL_COUNT=0
RAND_STATE=1
FAST_RAND_STATE=1
FAST_RAND_READY=0
PICKED_QTYPE="$_TYPE"

QTYPE_KEYS=""
QTYPE_COUNTS=""

init_query_type_tracking() {
    QTYPE_KEYS=""
    QTYPE_COUNTS=""
    seen=" "

    for t in $RANDOM_RR_POOL; do
        u="$(printf '%s' "$t" | tr '[:lower:]' '[:upper:]')"

        case "$u" in
            ''|*[!A-Z0-9_]*)
                continue
                ;;
        esac

        case "$seen" in
            *" $u "*)
                continue
            ;;
        esac

        seen="${seen}${u} "
        QTYPE_KEYS="${QTYPE_KEYS}${QTYPE_KEYS:+ }${u}"

        if [ -z "$QTYPE_COUNTS" ]; then
            QTYPE_COUNTS="$(printf '%s %s' "$u" "0")"
        else
            QTYPE_COUNTS="$(printf '%s\n%s %s' "$QTYPE_COUNTS" "$u" "0")"
        fi

    done

}

QUERY_TYPE_FILE=""

bump_query_type_count() {

    [ "${_RANDOM:-0}" -eq 1 ] || return 0

    [ -n "${QUERY_TYPE_FILE:-}" ] || return 0

