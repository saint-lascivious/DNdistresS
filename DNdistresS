            cat <<EOF
Values:
  0=CRITICAL
  1=ERROR
  2=WARNING
  3=INFO
  4=DEBUG
  5=TRACE

Default:
  $_VERBOSITY

Note:
  Runtime reports are displayed at verbosity levels 1 (ERROR) and higher.
  Verbosity 0 (CRITICAL) suppresses all runtime output, showing only
  critical failures that cause immediate exit.

See also:
  --help log-mode
  --help output
EOF

            ;;
        log-mode)

            help_topic_header "log-mode"

            cat <<EOF
Meaning:
  Controls how log() routes messages.

Variable:
  LOG_MODE

Values:
  auto   -> stderr when interactive (-t 2), logger otherwise
  stderr -> always stderr
  logger -> always logger (falls back to stderr if logger missing)
  both   -> mirror to stderr and logger

Default:
  $LOG_MODE

See also:
  --help verbosity
EOF

            ;;
        *)

            log 1 "unknown help topic: ${LIGHT_GREY}$topic"

            usage

            return 2
            ;;
    esac

}

