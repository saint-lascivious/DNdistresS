parse_resolver_cli_arg() {
    _mode="$1"
    _opt="$2"
    _raw="$3"

    case "$_mode" in
        local)
            SEEN_L=1

            [ "$_LOCATION_EXPLICIT" -eq 1 ] || { _LOCATION="local"; _LOCATION_FORCED=0; }

            ;;
        remote)
            SEEN_R=1

            [ "$_LOCATION_EXPLICIT" -eq 1 ] || { _LOCATION="remote"; _LOCATION_FORCED=0; }

            ;;
        *)
            return 1
            ;;
    esac

    oldifs=$IFS
    IFS=,
    # shellcheck disable=SC2086
    set -- $_raw
    IFS=$oldifs

    [ "$#" -gt 0 ] || set -- "$_raw"

    for _item in "$@"; do
        _item="$(printf '%s' "$_item" | awk '{gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print}')"

        [ -n "$_item" ] || continue

        parse_dns_opt "$_item" || {

            log 1 "invalid ${LIGHT_GREY}${_opt} ${RED}value: ${LIGHT_GREY}${_item}"

            return 1
        }

        _h="$PARSED_DNS_HOST"
        _p="${PARSED_DNS_PORT:-$_PORT}"

        is_port "$_p" || {

            log 1 "invalid ${LIGHT_GREY}${_opt} ${RED}port: ${LIGHT_GREY}${_p}"

            return 1
        }

        case "$_mode" in
            local)
                _LOCAL="$_h"

                append_pool_unique local "${_h}#${_p}" || return 1

                ;;
            remote)
                _REMOTE="$_h"

                append_pool_unique remote "${_h}#${_p}" || return 1

                ;;
        esac

        [ -n "$PARSED_DNS_PORT" ] && _PORT="$PARSED_DNS_PORT"

    done

    return 0
}

