OnCalendar=hourly
Persistent=true
RandomizedDelaySec=${TIMER_RANDOM_DELAY}
AccuracySec=1min
Unit=${UNIT_BASE}.service

[Install]
WantedBy=timers.target
EOF

}

COMPLETION_BASENAME="DNdistresS"
COMPLETION_DIR="${COMPLETION_DIR:-}"

resolve_completion_dir() {

    if [ -n "${COMPLETION_DIR:-}" ]; then
        printf '%s\n' "$COMPLETION_DIR"
        return 0
    fi

    if [ "$(id -u)" -eq 0 ]; then

        for d in \
            /usr/share/bash-completion/completions \
            /usr/local/share/bash-completion/completions \
            /etc/bash_completion.d \
            /usr/local/etc/bash_completion.d
        do

            [ -d "$d" ] || continue

            printf '%s\n' "$d"
            return 0
        done

        printf '%s\n' "/etc/bash_completion.d"
        return 0
    fi

    base="${XDG_DATA_HOME:-${HOME:-}/.local/share}"

    [ -n "$base" ] || return 1

    printf '%s\n' "$base/bash-completion/completions"
}

write_bash_completion() {
    out="$1"

    cat > "$out" <<'EOF'
_DNdistresS_help_topics() {
    local bin topics

    bin="$(command -v DNdistresS 2>/dev/null || true)"

    if [ -n "$bin" ]; then
        topics="$("$bin" --help topics-list 2>/dev/null | awk '
            /^[a-z][a-z0-9-]*$/ { if (!seen[$0]++) print $0 }
        ')"

        if [ -z "$topics" ]; then
            topics="$("$bin" --help topics 2>/dev/null | awk '
                /^[[:space:]]+General:|^[[:space:]]+Commands:|^[[:space:]]+Options:/ { sect=1; next }
                /^[[:space:]]+Aliases:/ { sect=0; next }
                sect && /^[[:space:]]{4}/ {

                    for (i = 1; i <= NF; i++) {

                        if ($i ~ /^[a-z][a-z0-9-]*$/) print $i

                    }

                }
            ' | awk '!seen[$0]++')"
        fi

        if [ -n "$topics" ]; then
            printf '%s\n' "$topics"
            return 0
        fi

    fi

    printf '%s\n' \
        general usage topics topics-list what why info examples description \
        runtime resolver resolver-strategy domains status environment \
        exit-codes install uninstall show version help auto-tune batch binary \
        burst force-burst column custom dig-options dig-options-mode \
        strict-dig-options directory duration file format local location maximum \
        force-maximum output port qps random remote seconds top type deny-any \
        allow-any url verbosity log-mode clock-tick-ms drain-timeout-ms \
        with-systemd with-bash-completion \
        full
}

_DNdistresS_show_topics() {
    printf '%s\n' w c warranty conditions
}

_DNdistresS_completion() {
    local cur prev tok i
    local cmd=""
    local help_ctx=0
    local show_ctx=0
    local show_topic_seen=0
    local has_random=0
    local has_type=0
    local has_mode_path=0

    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    type compopt >/dev/null 2>&1 && compopt +o default +o bashdefault +o filenames 2>/dev/null || true

    local common_opts="-h --help -V --verbosity"
    local mode_switch_opts="-i --install -u --uninstall -S --show \
        --show-warranty --show-conditions -v --version --full --with-systemd \
        --without-systemd --with-bash-completion --without-bash-completion --purge"

    local run_opts="-b -B -c -C -d -D -f -F -l -L -m -o -p -q -r -R -s -t -T \
        -U --allow-any --auto-tune --batch --binary --burst --column --custom --deny-any \
        --dig-options --dig-options-mode --directory --duration --file --force-burst \
        --force-maximum --format --local --location --maximum --output --port --qps \
        --random --remote --resolver-strategy --seconds --top --type --url"

    for ((i = 1; i < COMP_CWORD; i++)); do
        tok="${COMP_WORDS[i]}"

        case "$tok" in
            help|-h|--help)
                help_ctx=1
                ;;
            show|-S|--show|--show-warranty|--show-conditions)
                show_ctx=1

                [[ -z "$cmd" ]] && cmd="show"

                ;;
            install|-i|--install)

                [[ -z "$cmd" ]] && cmd="install"

                ;;
            uninstall|-u|--uninstall)

                [[ -z "$cmd" ]] && cmd="uninstall"

                ;;
            version|-v|--version)

                [[ -z "$cmd" ]] && cmd="version"

                ;;
        esac

        case "$tok" in
            -R|--random)
                has_random=1
                ;;
            -T|--type)
                has_type=1
                ;;
        esac

        if [[ "$cmd" == "show" ]]; then

            case "$tok" in
                w|c|warranty|conditions)
                    show_topic_seen=1
                    ;;
            esac

        fi

        if [[ "$cmd" == "install" || "$cmd" == "uninstall" ]]; then

            case "$tok" in
                install|uninstall|-i|--install|-u|--uninstall|-*|'')
                    ;;
                *)
                    has_mode_path=1
                    ;;
            esac

        fi

    done

    if [[ "$help_ctx" -eq 1 ]]; then
        local topics
        topics="$(_DNdistresS_help_topics | tr '\n' ' ')"
        COMPREPLY=( $(compgen -W "$topics" -- "$cur") )
        return 0
    fi

    if [[ "$COMP_CWORD" -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$mode_switch_opts $common_opts $run_opts" -- "$cur") )
        return 0
    fi

    case "$prev" in
        --batch)
            COMPREPLY=( $(compgen -W "2 4 8 16 32 64" -- "$cur") )
            return 0
            ;;
        -b|--binary)
            COMPREPLY=( $(compgen -W "auto dig nslookup" -- "$cur") )
            return 0
            ;;
        -B|--burst)
            COMPREPLY=( $(compgen -W "2 4 8 16 32" -- "$cur") )
            return 0
            ;;
        -c|--column)
            COMPREPLY=( $(compgen -W "0 1 2 3 4 5" -- "$cur") )
            return 0
            ;;
        -C|--custom)
            _filedir
            return 0
            ;;
        -d|--directory)
            _filedir -d
            return 0
            ;;
        -D|--duration)
            COMPREPLY=( $(compgen -W "60 300 600 3600 86400" -- "$cur") )
            return 0
            ;;
        -f|--file)
            _filedir
            return 0
            ;;
        -F|--format)
            COMPREPLY=( $(compgen -W "auto plain csv" -- "$cur") )
            return 0
            ;;
        -i|--install)

            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$common_opts --full --with-systemd --without-systemd --with-bash-completion --without-bash-completion" -- "$cur") )
            else
                _filedir -d
            fi

            return 0
            ;;
        -l|--local)
            COMPREPLY=( $(compgen -W "127.0.0.1 ::1" -- "$cur") )
            return 0
            ;;
        -L|--location)
            COMPREPLY=( $(compgen -W "auto local remote" -- "$cur") )
            return 0
            ;;
        -m|--maximum)
            COMPREPLY=( $(compgen -W "4 16 32 64 128" -- "$cur") )
            return 0
            ;;
        -o|--output)
            COMPREPLY=( $(compgen -W "quiet answer" -- "$cur") )
            return 0
            ;;
        -p|--port)
            COMPREPLY=( $(compgen -W "53 5335 5353 8853" -- "$cur") )
            return 0
            ;;
        -q|--qps)
            COMPREPLY=( $(compgen -W "16 32 64 128 256" -- "$cur") )
            return 0
            ;;
        -r|--remote)
            COMPREPLY=( $(compgen -W "1.1.1.1 1.0.0.1 8.8.4.4 8.8.8.8 2001:4860:4860::8888 2606:4700:4700::1111" -- "$cur") )
            return 0
            ;;
        --resolver-strategy)
            COMPREPLY=( $(compgen -W "rr random fastest parallel" -- "$cur") )
            return 0
            ;;
        -s|--seconds)
            COMPREPLY=( $(compgen -W "0 300 3600 86400 604800" -- "$cur") )
            return 0
            ;;
        -t|--top)
            COMPREPLY=( $(compgen -W "100 1000 5000 10000 50000" -- "$cur") )
            return 0
            ;;
        -T|--type)
            COMPREPLY=( $(compgen -W "A AAAA CAA CNAME MX NS PTR SOA SRV TXT" -- "$cur") )
            return 0
            ;;
        -u|--uninstall)

            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$common_opts --with-systemd --without-systemd --with-bash-completion --without-bash-completion --purge" -- "$cur") )
            else
                _filedir -d
            fi

            return 0
            ;;
        -U|--url)
            return 0
            ;;
        --dig-options)
            return 0
            ;;
        --dig-options-mode)
            COMPREPLY=( $(compgen -W "append replace" -- "$cur") )
            return 0
            ;;
        -V|--verbosity)
            COMPREPLY=( $(compgen -W "0 1 2 3 4 5" -- "$cur") )
            return 0
            ;;
        -S|--show)
            COMPREPLY=( $(compgen -W "$(_DNdistresS_show_topics | tr '\n' ' ')" -- "$cur") )
            return 0
            ;;
    esac

    case "$cmd" in
        show)

            if [[ "$show_topic_seen" -eq 1 ]]; then
                COMPREPLY=( $(compgen -W "$common_opts" -- "$cur") )
                return 0
            fi

            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$common_opts -S --show --show-warranty --show-conditions" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$(_DNdistresS_show_topics | tr '\n' ' ')" -- "$cur") )
            fi

            return 0
            ;;
        install)

            if [[ "$has_mode_path" -eq 0 ]]; then

                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "$common_opts --full --with-systemd --without-systemd --with-bash-completion --without-bash-completion" -- "$cur") )
                else
                    _filedir -d
                fi

                return 0
            fi

            COMPREPLY=( $(compgen -W "$common_opts --full --with-systemd --without-systemd --with-bash-completion --without-bash-completion" -- "$cur") )
            return 0
            ;;
        uninstall)

            if [[ "$has_mode_path" -eq 0 ]]; then

                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "$common_opts --with-systemd --without-systemd --with-bash-completion --without-bash-completion --purge" -- "$cur") )
                else
                    _filedir -d
                fi

                return 0
            fi

            COMPREPLY=( $(compgen -W "$common_opts --with-systemd --without-systemd --with-bash-completion --without-bash-completion --purge" -- "$cur") )
            return 0
            ;;
        version|help)
            COMPREPLY=( $(compgen -W "$common_opts" -- "$cur") )
            return 0
            ;;
    esac

    if [[ "$has_random" -eq 1 ]]; then
        run_opts="${run_opts// -T / }"
        run_opts="${run_opts// --type / }"
    fi

    if [[ "$has_type" -eq 1 ]]; then
        run_opts="${run_opts// -R / }"
        run_opts="${run_opts// --random / }"
    fi

    COMPREPLY=( $(compgen -W "$run_opts $mode_switch_opts $common_opts" -- "$cur") )
    return 0
}

complete -F _DNdistresS_completion DNdistresS
EOF

}

do_install() {
    target="$1"
    completion_dir=""

    is_valid_target_dir "$target" || {

        log 1 "invalid install path: ${LIGHT_GREY}$target"

        exit_with_status "$EXIT_USAGE"

    }

    as_root_or_sudo -i "$target" -V "$_VERBOSITY" || exit_with_status "$EXIT_PERMISSIONS"

    [ ! -t 2 ] || [ "$_VERBOSITY" -lt 3 ] || print_banner >&2

    case "${_DIRECTORY:-}" in
        ''|/home/*|/root/*)
            service_directory="$DEFAULT_ROOT_DIRECTORY"
            ;;
        *)
            service_directory="$_DIRECTORY"
            ;;
    esac

    mkdir -p "$target"

    dirs_msg="${LIGHT_GREY}$target"
    dir_count=1

    if [ "$_WITH_BASH_COMPLETION" -eq 1 ]; then

        completion_dir="$(resolve_completion_dir)" || {

            log 1 "failed to resolve bash completion directory"

            exit_with_status "$EXIT_INSTALL"

        }

        is_valid_target_dir "$completion_dir" || {

            log 1 "invalid bash completion path: ${LIGHT_GREY}$completion_dir"

            exit_with_status "$EXIT_USAGE"

        }

        mkdir -p "$completion_dir"

        dirs_msg="$dirs_msg${GREY}, ${LIGHT_GREY}$completion_dir"
        dir_count=$((dir_count + 1))
    fi

    if [ "$_WITH_SYSTEMD" -eq 1 ]; then

        mkdir -p "$SERVICE_DIR"

        dirs_msg="$dirs_msg${GREY}, ${LIGHT_GREY}$SERVICE_DIR"
        dir_count=$((dir_count + 1))
    fi

    if [ "$dir_count" -eq 1 ]; then

        log 4 "install directory exists: $dirs_msg"

    else

        log 4 "install directories exist: $dirs_msg"

    fi

    src="$(self_source_path)" || {

        log 1 "unable to resolve script path for installation"

        exit_with_status "$EXIT_INSTALL"

    }

    if need_cmd install; then

        install -m 0755 "$src" "$target/$UNIT_BASE" || {

            log 1 "install command failed"

            exit_with_status "$EXIT_TOOLING"

        }

        log 3 "installed: ${LIGHT_GREY}$target/$UNIT_BASE"

        log 4 "installed using ${LIGHT_GREY}install ${GREY}command"

    else

        cp "$src" "$target/$UNIT_BASE" || {

            log 1 "${LIGHT_GREY}cp ${RED}failed while installing binary"

            exit_with_status "$EXIT_TOOLING"

        }

        chmod 0755 "$target/$UNIT_BASE" || {

            log 1 "${LIGHT_GREY}chmod ${RED}failed while installing binary"

            exit_with_status "$EXIT_TOOLING"

        }

        log 3 "installed: ${LIGHT_GREY}$target/$UNIT_BASE"

        log 4 "installed using ${LIGHT_GREY}cp${GREY} and ${LIGHT_GREY}chmod ${GREY}commands"

    fi

    if [ "$_WITH_SYSTEMD" -eq 1 ]; then

        mkdir -p "$SERVICE_DIR"

        write_service_unit "$SERVICE_DIR/${UNIT_BASE}.service" "$target/$UNIT_BASE" "$service_directory" || {

            log 1 "failed to write service unit safely"

            exit_with_status "$EXIT_INSTALL"

        }

        log 3 "installed: ${LIGHT_GREY}$SERVICE_DIR/${UNIT_BASE}.service"

        write_timer_unit "$SERVICE_DIR/${UNIT_BASE}.timer" || {

            log 1 "failed to write timer unit safely"

            exit_with_status "$EXIT_INSTALL"

        }

        log 3 "installed: ${LIGHT_GREY}$SERVICE_DIR/${UNIT_BASE}.timer"

        systemctl_maybe daemon-reload

        systemctl_maybe reset-failed "${UNIT_BASE}.service" "${UNIT_BASE}.timer"

        systemctl_maybe enable --now "${UNIT_BASE}.timer"

        log 3 "reloaded systemd daemon, cleared stale failed state, and enabled timer ${LIGHT_GREY}${UNIT_BASE}.timer"

    else

        log 3 "skipping systemd unit installation (default)"

        log 3 "use ${LIGHT_GREY}--with-systemd ${BLUE}to enable"

    fi

    if [ "$_WITH_BASH_COMPLETION" -eq 1 ]; then

        write_bash_completion "$completion_dir/$COMPLETION_BASENAME" || {

            log 1 "failed to write bash completion"

            exit_with_status "$EXIT_TOOLING"

        }

        log 3 "installed: ${LIGHT_GREY}$completion_dir/$COMPLETION_BASENAME"

    else

        log 3 "skipping bash completion installation (default)"

        log 3 "use ${LIGHT_GREY}--with-bash-completion ${BLUE}to enable"

    fi

}

do_uninstall() {
    target="$1"
    completion_dir=""

    is_valid_target_dir "$target" || {

        log 1 "invalid uninstall path: ${LIGHT_GREY}$target"

        exit_with_status "$EXIT_USAGE"

    }

    as_root_or_sudo -u "$target" -V "$_VERBOSITY" || exit_with_status "$EXIT_PERMISSIONS"

    [ ! -t 2 ] || [ "$_VERBOSITY" -lt 3 ] || print_banner >&2

    completion_dir="$(resolve_completion_dir 2>/dev/null || true)"

    [ -n "$completion_dir" ] || completion_dir="/nonexistent"

    service_unit="$SERVICE_DIR/${UNIT_BASE}.service"
    timer_unit="$SERVICE_DIR/${UNIT_BASE}.timer"
    binary_path="$target/$UNIT_BASE"
    completion_path="$completion_dir/$COMPLETION_BASENAME"

    log 3 "running opportunistic uninstall"

    if [ -e "$completion_path" ]; then

        rm -f "$completion_path" || true

        log 3 "removed bash completion: ${LIGHT_GREY}$completion_path"

    else

        log 3 "skipping bash completion uninstall"

        log 3 "bash completion not present: ${LIGHT_GREY}$completion_path"

    fi

    have_units=0

    [ -e "$service_unit" ] && have_units=1

    [ -e "$timer_unit" ] && have_units=1

    if [ "$have_units" -eq 1 ]; then

        systemctl_maybe disable --now "${UNIT_BASE}.timer"

        systemctl_maybe stop "${UNIT_BASE}.service"

        rm -f "$service_unit" "$timer_unit" || true

        systemctl_maybe daemon-reload

        systemctl_maybe reset-failed "${UNIT_BASE}.service" "${UNIT_BASE}.timer"

        log 3 "removed systemd units for ${LIGHT_GREY}${UNIT_BASE}"

    else

        log 3 "skipping systemd unit uninstall"

        log 3 "no systemd units found at ${LIGHT_GREY}$SERVICE_DIR"

    fi

    if [ -e "$binary_path" ]; then

        rm -f "$binary_path" || true

        log 3 "removed binary: ${LIGHT_GREY}$binary_path"

    else

        log 3 "skipping binary uninstall"

        log 3 "binary not present: ${LIGHT_GREY}$binary_path"

    fi

    if [ "${_PURGE:-0}" -eq 1 ]; then

        log 3 "purge requested: removing cache/state/runtime artefacts"

        purge_dir_if_dedicated() {
            _label="$1"
            _dir="$2"

            case "$_dir" in
                /|/var|/var/lib|/var/cache|/var/lock|/run|/etc|/usr|/home|/root|''|.)

                    log 2 "refusing to purge shared/system path for ${LIGHT_GREY}${_label}${YELLOW}: ${LIGHT_GREY}${_dir}"

                    return 1
                    ;;
            esac

            [ -d "$_dir" ] || {

                log 3 "skipping ${_label} purge"

                log 3 "${_label} directory not present: ${LIGHT_GREY}$_dir"

                return 0
            }

            rm -rf "$_dir" || {

                log 1 "failed to purge ${_label} directory: ${LIGHT_GREY}$_dir"

                return 1
            }

            log 3 "purged ${_label}: ${LIGHT_GREY}$_dir"

            return 0
        }

        case "${_DIRECTORY:-}" in
            "$DEFAULT_ROOT_DIRECTORY"|"${XDG_CACHE_HOME:-${HOME:-}/.cache}/DNdistresS")

                purge_dir_if_dedicated "cache" "${_DIRECTORY:-$DEFAULT_ROOT_DIRECTORY}"

                ;;
            *)

                log 3 "skipping cache purge"

                log 3 "_DIRECTORY does not match a known default, leaving untouched: ${LIGHT_GREY}${_DIRECTORY:-"(unset)"}"

                ;;
        esac

        purge_dir_if_dedicated "state" "$DEFAULT_STATE_ROOT"

        purge_dir_if_dedicated "runtime" "$DEFAULT_RUNTIME_ROOT"

        case "${_LOCK_FILE:-}" in
            ''|/var/lock|/run)
                ;;
            *)

                if [ -e "$_LOCK_FILE" ]; then

                    rm -f "$_LOCK_FILE" || true

                    log 3 "removed lock file: ${LIGHT_GREY}$_LOCK_FILE"

                fi

                ;;
        esac

    else

        log 3 "skipping cache/state/runtime purge (default)"

        log 3 "use ${LIGHT_GREY}--purge ${BLUE}to remove cache, status, and runtime artefacts"

    fi

}

enforce_file_ceiling() {
    f="$1"
    max="$2"
    what="$3"

    case "$max" in
        ''|*[!0-9]*) return 1 ;;
    esac

    [ "$max" -gt 0 ] || return 0

    if [ -f "$f" ]; then
        sz="$(wc -c < "$f" | tr -d ' ')"
    else
        sz=0
    fi

    case "$sz" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    if [ "$sz" -gt "$max" ]; then

        log 1 "${what} exceeds ceiling (${LIGHT_GREY}${sz}B${RED} > ${LIGHT_GREY}${max}B${RED})"

        return 1
    fi

    return 0
}

download_file() {
    src="$1"
    dst="$2"

    if need_cmd curl; then

        log 3 "downloading using ${LIGHT_GREY}curl"

        log 4 "${LIGHT_GREY}$src ${GREY}-> ${LIGHT_GREY}$dst"

        curl -fsSL "$src" -o "$dst" || {

            log 1 "download failed with ${LIGHT_GREY}curl${GREY}: ${LIGHT_GREY}$src"

            return 1
        }

    elif need_cmd wget; then

        log 3 "downloading using ${LIGHT_GREY}wget"

        log 4 "${LIGHT_GREY}$src ${GREY}-> ${LIGHT_GREY}$dst"

        wget -qO "$dst" "$src" || {

            log 1 "download failed with ${LIGHT_GREY}wget${GREY}: ${LIGHT_GREY}$src"

            return 1
        }

    else

        log 1 "need ${LIGHT_GREY}curl${GREY} or ${LIGHT_GREY}wget${GREY} for downloading"

        return 1
    fi

    enforce_file_ceiling "$dst" "$_MAX_DOWNLOAD_BYTES" "downloaded file" || {

        rm -f "$dst" 2>/dev/null || true

        return 1
    }

}

validate_zip_file() {
    z="$1"

    need_cmd unzip || return 1

    unzip -t "$z" >/dev/null 2>&1

}

extract_zip_to_file() {
    z="$1"
    out="$2"

    need_cmd unzip || return 1

    member="$(unzip -Z1 "$z" 2>/dev/null | awk 'NF && $0 !~ /\/$/ { print; exit }')"

    [ -n "$member" ] || return 1

    unzip -p "$z" "$member" > "$out" 2>/dev/null || return 1

    [ -s "$out" ] || return 1

    enforce_file_ceiling "$out" "$_MAX_EXTRACT_BYTES" "extracted zip payload" || {

        rm -f "$out" 2>/dev/null || true

        return 1
    }

    return 0
}

CACHE_AGE=0
FETCH_CACHE_TMP=""
FETCH_SOURCE_PATH=""

fetch_source() {

    cache_key() {
        key="$(printf '%s\n' "$1" | cksum | awk '{ print $1 }')"
        printf '%s\n' "$key"
    }

    dst="$1"
    FETCH_SOURCE_PATH=""

    if [ -n "$_FILE" ]; then

        log 3 "using local source: ${LIGHT_GREY}$_FILE"

        FETCH_SOURCE_PATH="$_FILE"
        return 0
    fi

    if [ "$_SECONDS" -eq 0 ]; then

        log 3 "downloading: ${LIGHT_GREY}$_URL"

        log 4 "cache disabled: ttl=${LIGHT_GREY}0s"

        download_file "$_URL" "$dst" || return 1

        case "$_URL" in
            *.zip)

                validate_zip_file "$dst" || {

                    log 1 "downloaded zip failed integrity check: ${LIGHT_GREY}$_URL"

                    return 1
                }

                ;;
        esac

        FETCH_SOURCE_PATH="$dst"
        return 0
    fi

    mkdir -p "$_DIRECTORY" || {

        log 1 "failed to create cache directory: ${LIGHT_GREY}$_DIRECTORY"

        return 1
    }

    key="$(cache_key "$_URL")"
    cache_raw="$_DIRECTORY/$key.raw"
    cache_stamp="$_DIRECTORY/$key.stamp"
    cache_lock="$_DIRECTORY/$key.lock.d"
    now="$(( $(now_ms) / 1000 ))"

    release_cache_lock() {

        rmdir "$cache_lock" 2>/dev/null || true

    }

    lock_tries=0

    while ! mkdir "$cache_lock" 2>/dev/null; do
        lock_tries=$((lock_tries + 1))

        [ "$lock_tries" -lt 200 ] || {

            log 1 "failed to acquire cache lock: ${LIGHT_GREY}$cache_lock"

            return 1
        }

        sleep_ms 50

    done

    cache_raw_base="$(basename "$cache_raw")"
    cache_stamp_base="$(basename "$cache_stamp")"

    log 5 "cache: key=${LIGHT_GREY}$key${GREY} raw=${LIGHT_GREY}$cache_raw_base${GREY}"

    log 5 "cache: stamp=${LIGHT_GREY}$cache_stamp_base${GREY} now=${LIGHT_GREY}$now"

    if [ -f "$cache_raw" ] && [ -f "$cache_stamp" ]; then
        cached_at="$(cat "$cache_stamp" 2>/dev/null || printf '0')"

        case "$cached_at" in
            ''|*[!0-9]*)
                cached_at=0
                ;;
        esac

        CACHE_AGE=$((now - cached_at))

        log 4 "cache: age=${LIGHT_GREY}${CACHE_AGE}s${GREY} ttl=${LIGHT_GREY}${_SECONDS}s"

        if [ "$CACHE_AGE" -lt "$_SECONDS" ]; then

            log 3 "cache hit: ${LIGHT_GREY}$cache_raw"

            FETCH_SOURCE_PATH="$cache_raw"

            release_cache_lock

            return 0
        fi

        log 3 "cache stale: ${LIGHT_GREY}$cache_raw"

    fi

    log 3 "downloading: ${LIGHT_GREY}$_URL"

    log 5 "downloading to temp before promoting to cache"

    cache_tmp="${cache_raw}.tmp.$$"
    FETCH_CACHE_TMP="$cache_tmp"

    download_file "$_URL" "$cache_tmp" || {

        rm -f "$cache_tmp"

        FETCH_CACHE_TMP=""

        release_cache_lock

        return 1
    }

    case "$_URL" in
        *.zip)

            validate_zip_file "$cache_tmp" || {

                log 1 "downloaded zip failed integrity check, discarding: ${LIGHT_GREY}$_URL"

                rm -f "$cache_tmp"

                FETCH_CACHE_TMP=""

                release_cache_lock

                return 1
            }

            log 4 "zip integrity okay"

            ;;
    esac

    mv "$cache_tmp" "$cache_raw" || {

        log 1 "cache promotion failed"

        log 4 "${LIGHT_GREY}$_URL ${GREY}-> ${LIGHT_GREY}$cache_raw"

        log 4 "removing temp file: ${LIGHT_GREY}$cache_tmp"

        rm -f "$cache_tmp"

        FETCH_CACHE_TMP=""

        release_cache_lock

        return 1
    }

    FETCH_CACHE_TMP=""
    printf '%s\n' "$now" > "$cache_stamp" || {

        log 1 "failed to write cache stamp: ${LIGHT_GREY}$cache_stamp"

        release_cache_lock

        return 1
    }

    log 3 "cache updated: ${LIGHT_GREY}$cache_raw"

    FETCH_SOURCE_PATH="$cache_raw"

    release_cache_lock

    return 0
}

extract_domains() {

    awk -F',' -v fmt="$_FORMAT" -v col="$_COLUMN" '

        function norm(x) {
            gsub(/\r/, "", x)
            sub(/^[[:space:]]+/, "", x)
            sub(/[[:space:]]+$/, "", x)
            x=tolower(x)
            sub(/\.$/, "", x)
            return x
        }

        function is_domain(x, n, i, lab) {

            if (x == "") return 0

            if (length(x) > 253) return 0

            if (x ~ /\.\./) return 0

            n=split(x, a, ".")

            for (i=1; i<=n; i++) {
                lab=a[i]

                if (lab == "") return 0

                if (length(lab) > 63) return 0

                if (lab !~ /^[a-z0-9-]+$/) return 0

                if (lab ~ /^-/ || lab ~ /-$/) return 0
            }

            return 1
        }

        {
            d=""

            if (fmt == "plain") {
                d=norm($0)

                if (is_domain(d)) print d

                next
            }

            if (col > 0) {

                if (col <= NF) {
                    d=norm($col)

                    if (is_domain(d)) print d

                }

                next
            }

            if (NF == 1) {
                d=norm($1)

                if (is_domain(d)) {
                    print d
                    next
                }

            }

            if ($1 ~ /^[0-9]+$/ && NF >= 2) {
                d=norm($2)

                if (is_domain(d)) {
                    print d
                    next
                }

            }

            for (i=1; i<=NF; i++) {
                d=norm($i)

                if (is_domain(d) && d !~ /^[0-9]+$/) {
                    print d
                    break
                }

            }

        }
    '

}

extract_custom_domains() {

    awk '

        function norm(x) {
            gsub(/\r/, "", x)
            sub(/[[:space:]]*#.*$/, "", x)
            sub(/^[[:space:]]+/, "", x)
            sub(/[[:space:]]+$/, "", x)
            x=tolower(x)
            sub(/\.$/, "", x)
            return x
        }

        function is_domain(x, n, i, lab) {
            if (x == "") return 0

            if (length(x) > 253) return 0

            if (x ~ /\.\./) return 0

            n=split(x, a, ".")

            for (i=1; i<=n; i++) {
                lab=a[i]

                if (lab == "") return 0

                if (length(lab) > 63) return 0

                if (lab !~ /^[a-z0-9-]+$/) return 0

                if (lab ~ /^-/ || lab ~ /-$/) return 0
            }

            return 1
        }

        {
            d=norm($0)

            if (d == "") next

            if (is_domain(d)) print d

        }
    '

}

