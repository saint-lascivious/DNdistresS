log_apply_level_style() {
    _msg="${1:-}"
    _base="${2:-}"

    [ -n "$_msg" ] || {
        printf '%s' "$_msg"
        return 0
    }

    [ -n "$_base" ] || {
        printf '%s' "$_msg"
        return 0
    }

    [ -n "${NONE:-}" ] || {
        printf '%s' "$_msg"
        return 0
    }

    printf '%s' "$_msg" | awk -v n="$NONE" -v b="$_base" '
        {
            s = $0
            out = ""

            while ((p = index(s, n)) > 0) {
                out = out substr(s, 1, p + length(n) - 1) b
                s = substr(s, p + length(n))
            }

            if (NR > 1) printf "\n"

            printf "%s%s%s", b, out s, n
        }
    '
}

log() {
    lvl="${1:-3}"

    case "${_VERBOSITY:-0}" in
        0|1|2|3|4|5)
            v="${_VERBOSITY}"
            ;;
        *)
            v=0
            ;;
    esac

    case "$lvl" in
        0|critical|CRITICAL)
            n=0
            ;;
        1|error|ERROR)
            n=1
            ;;
        2|warning|WARNING|warn|WARN)
            n=2
            ;;
        3|info|INFO)
            n=3
            ;;
        4|debug|DEBUG)
            n=4
            ;;
        5|trace|TRACE)
            n=5
            ;;
        *)
            n=2
            ;;
    esac

    [ "$v" -ge "$n" ] || return 0

    shift || true

    msg="${*:-}"

    case "$lvl" in
        0|critical|CRITICAL)
            pfx="${LIGHT_GREY}[${BOLD}${RED}!${NONE}${LIGHT_GREY}]${NONE}"
            pri="user.crit"
            base="${RED}"
            ;;
        1|error|ERROR)
            pfx="${LIGHT_GREY}[${RED}✗${LIGHT_GREY}]${NONE}"
            pri="user.err"
            base="${RED}"
            ;;
        2|warning|WARNING|warn|WARN)
            pfx="${LIGHT_GREY}[${YELLOW}▲${LIGHT_GREY}]${NONE}"
            pri="user.warning"
            base="${YELLOW}"
            ;;
        3|info|INFO)
            pfx="${LIGHT_GREY}[${ITALIC}${BLUE}i${NONE}${LIGHT_GREY}]${NONE}"
            pri="user.info"
            base="${BLUE}"
            ;;
        4|debug|DEBUG)
            pfx="${LIGHT_GREY}[${GREY}•${LIGHT_GREY}]${NONE}"
            pri="user.debug"
            base="${GREY}"
            ;;
        5|trace|TRACE)
            pfx="${LIGHT_GREY}[${GREY}◦${LIGHT_GREY}]${NONE}"
            pri="user.debug"
            base="${GREY}"
            ;;
        *)
            pfx="${LIGHT_GREY}[${BLUE}?${LIGHT_GREY}]${NONE}"
            pri="user.warning"
            base="${YELLOW}"
            ;;
    esac

    do_stderr=0
    do_logger=0

    case "${LOG_MODE:-auto}" in
        stderr)
            do_stderr=1
            ;;
        logger)
            do_logger=1
            ;;
        both)
            do_stderr=1
            do_logger=1
            ;;
        auto|'')

            if [ -t 2 ]; then
                do_stderr=1
            else
                do_logger=1
            fi

            ;;
        *)

            if [ -t 2 ]; then
                do_stderr=1
            else
                do_logger=1
            fi

            ;;
    esac

    render_msg="$(log_apply_level_style "$msg" "$base")"

    if [ "$do_logger" -eq 1 ] && [ "$HAVE_LOGGER" -eq 1 ]; then
        _esc="$(printf '\033')"
        clean_msg="$(printf '%s' "$render_msg" | sed "s/${_esc}\[[0-9;]*[[:alpha:]]//g")"

        logger -t "$LOG_TAG" -p "$pri" -- "$clean_msg"

    elif [ "$do_logger" -eq 1 ] && [ "$do_stderr" -eq 0 ]; then
        do_stderr=1
    fi

    if [ "$do_stderr" -eq 1 ]; then
        printf '%b %b\n' "$pfx" "$render_msg" >&2
    fi

}

